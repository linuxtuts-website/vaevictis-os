#!/bin/sh
# vaevictis-tools: puts the fixed VaeVictis tools in place of the copies the 1.1 image installed, at the same paths
# (the desktop launchers, the polkit rule and the sudo rule expect them there).
# A copy is replaced ONLY if it is exactly a version VaeVictis shipped, or already this version. Any other copy
# (changed locally, or from 1.0 / 1.0.1) is left alone with a message, and a missing tool is never added.
# Every replaced copy is kept in /var/lib/vaevictis-tools/backup/DATE/.
set -e

PAYLOAD=/usr/lib/vaevictis-tools
STATE=/var/lib/vaevictis-tools

# path, mode, file in the payload, then the SHA-256 of every VaeVictis version that may be replaced:
# the 1.1 image (for the polkit rule and the panic button, 1.0.1 shipped the same files), then vaevictis-tools 1.2.0, then
# vaevictis-tools 1.3.0 (the same files as the 1.2 image); for the VPN helper also the two test builds of 1.4.0 of
# 21 October 2026 (never published: test machines only).
# EVERY NEW VERSION OF THIS PACKAGE ADDS THE HASHES OF THE PREVIOUS ONE, or systems that have it are not updated.
LIST='/usr/local/libexec/vv-sandbox                     0755 vv-sandbox               d12d4327e48c81db6ca9fea0e8857df614c707294cf669f6fa8001d146381e36 a5af744469319f25a9d18f244d8a500dc4983948222f03746b84602ca2e66e65 6db325527ecd43784c5f62d30b4f9a02c761bfec361bd06b458754aa005fa52a
/usr/local/libexec/vv-vpn-helper                  0755 vv-vpn-helper            26c4f131dc2819ca32d22474f0096a0fc124e01eaaadaf131a5dbbb049dd94ad bc5ffbd8bcc139bc5b5307946b72734c900bd71eabc653cc1756f7884244ecc5 73af4f1bbe8a62f3738badfd47aa6d55d7d1b971bc662d0a4d8102bc86e07826 0fc688c0b14ccd9a6e9c9ca89561fd463376d8c9eb2468fc61942c9eef8f515e
/usr/local/bin/vv-vpn                             0755 vv-vpn                   d7bc24e0d347fe57d900a044d59647a7cfb3d738cdb01dac3a18e8155711ca49 75309622155f0e9b7df820006ec17d606764d450a8ce57dfe9f2dad39636f0dd 418dab6fe3ba2568e0dad771e4d013167a2b02aaac1309873f55f830dfcc5cc1
/usr/share/polkit-1/actions/org.vaevictis.vpn.policy 0644 org.vaevictis.vpn.policy c049888475f0179b60f82a99184e7f2cd438126ffd9ede45e70cb2c78099798a ff7e6861bd7d35155cacd205e7e6a36eba63e393c68392fccf9b984ed57cc527
/usr/local/bin/v-snap                             0755 v-snap                   c496231ec2a55f9c4d3a290cb4f564a835c600bc5d5689431857480da37dafc8 3635e7499114d44705241aad03c1ff1e29617349d7c6718a1837ae532648b0ec
/usr/local/bin/vv-panic                           0755 vv-panic                 4cd6eb1e718c0ca719352064a91a0f4a23614185c6dfe372aec553cf589bc045 93b32609f508b84fc2205a0b3cf06fb505dbb2f9822d7f0eed7d18eed92c0b7d
/usr/local/libexec/vv-panic-action                0755 vv-panic-action          1ed1207404ffdc8c2ff4a2767f3610ae3a1b7de79bd587c8be0d77225462fc1b 412868a112addfc7bf168ab099bfaefc44f521e236ce3d3689e49b4673e1603d
/usr/local/lib/vaevictis/vv-pdf                   0755 vv-pdf                   c30fcbb859369b8ed566126c111932626cd43adc5f42dcaa53b0f09836dd3ec0 15a9799340321a5be73a3eb04256e4f170b257f62a426d01b46dd6dc67ad6a64
/usr/local/lib/vaevictis/linpaint                 0755 linpaint                 dbe4acf2fce171665ae8dba8d63c74156aa84577db1536bb5aa948da2bf94f7b 84770dcfe7e255c96413f013ed29d7d6651439c7182749ff4a41daa95f245111
'

say() { echo "vaevictis-tools: $*"; }

case "$1" in
    configure)
        install -d -m 0700 "$STATE"
        backup="$STATE/backup/$(date +%Y%m%d-%H%M%S)"
        echo "$LIST" | while read -r target mode name known; do
            [ -n "$target" ] || continue
            new="$PAYLOAD/$name"
            newsum=$(sha256sum "$new" | cut -d' ' -f1)
            if [ -L "$target" ] || { [ -e "$target" ] && [ ! -f "$target" ]; }; then
                say "$target is not a regular file: left alone, NOT updated."
                continue
            fi
            if [ ! -e "$target" ]; then
                say "$target is not on this system: not added."
                continue
            fi
            cur=$(sha256sum "$target" | cut -d' ' -f1)
            [ "$cur" != "$newsum" ] || continue                  # already this version
            case " $known " in
                *" $cur "*) ;;
                *) say "$target is not a version VaeVictis shipped (changed locally, or from 1.0 / 1.0.1): left alone, NOT updated."
                   continue ;;
            esac
            install -d -m 0700 "$backup$(dirname "$target")"
            cp -p "$target" "$backup$target"
            install -o root -g root -m "$mode" "$new" "$target.vaevictis-new"
            mv -f "$target.vaevictis-new" "$target"
            say "updated $target (old copy: $backup$target)"
        done
        ;;
esac

exit 0
