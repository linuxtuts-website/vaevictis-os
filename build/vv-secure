#!/usr/bin/env bash
# vv-secure - conservative system hardening written into the VaeVictis chroot
#
#   vv-secure         apply (safe to repeat; replaced files are backed up next to the chroot)
#
# Rule of thumb: nothing here may stop a normal PC from booting, networking, mounting disks,
# running Firefox, Flatpak, virtual machines or proprietary graphics drivers.
# Settings with that risk are NOT included (see the list printed at the end).
set -euo pipefail

HERE="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
CH="${VV_CHROOT:-/run/media/user/Mio/Backup_VaeVictis_Completo/vaevictis/new/chroot}"
CH="$(realpath -m "$CH")"
VVC="$HERE/vv-chroot"

die() { echo "vv-secure: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || exec sudo -E VV_CHROOT="$CH" "$0" "$@"
[ -f "$CH/etc/debian_version" ] && [ "$CH" != "/" ] || die "not a Debian root filesystem: $CH"
[ -x "$VVC" ] || [ -n "${VV_SKIP_CHROOT:-}" ] || die "vv-chroot must be next to this script ($VVC)"

BK="$(dirname "$CH")/vv-backups/$(date +%Y%m%d-%H%M%S)"
bak() { local rel="${1#$CH/}"; [ -e "$1" ] || return 0; mkdir -p "$BK"; (cd "$CH" && cp -a --parents "$rel" "$BK/"); }
put() {   # put FILE   (content on stdin)
    install -d -m 0755 "$(dirname "$CH/$1")"; bak "$CH/$1"; cat > "$CH/$1"; chmod 0644 "$CH/$1"; echo "  /$1"
}
in_chroot() {
    if [ -n "${VV_SKIP_CHROOT:-}" ]; then echo "  [skipped in test] $(echo "$1" | head -c 200)"; return 0; fi
    "$VVC" run /bin/sh -c "$1"
}

echo "== kernel settings (sysctl)"
put etc/sysctl.d/90-vaevictis-hardening.conf <<'EOF'
# VaeVictis kernel hardening (generated by vv-secure).
# A leading "-" means: ignore the line if this kernel does not have that setting.

# Hide kernel addresses and the kernel log from normal users
kernel.kptr_restrict = 2
kernel.dmesg_restrict = 1

# No BPF for unprivileged users, harden the BPF JIT
-kernel.unprivileged_bpf_disabled = 1
-net.core.bpf_jit_harden = 2

# A process cannot ptrace one it did not start; no perf for normal users
-kernel.yama.ptrace_scope = 1
-kernel.perf_event_paranoid = 3

# No loading another kernel at runtime, no auto-loading of obscure tty line disciplines
kernel.kexec_load_disabled = 1
-dev.tty.ldisc_autoload = 0
-vm.unprivileged_userfaultfd = 0

# Classic file-system tricks
fs.protected_hardlinks = 1
fs.protected_symlinks = 1
fs.protected_fifos = 2
fs.protected_regular = 2

# Crashing programs must not dump memory (passwords, keys) to disk
fs.suid_dumpable = 0
kernel.core_pattern = |/bin/false

# Network: no redirects or source routing, SYN cookies
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.secure_redirects = 0
net.ipv4.conf.default.secure_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
# Log packets with impossible source addresses (spoofing attempts, misconfigured networks)
net.ipv4.conf.all.log_martians = 1
net.ipv4.conf.default.log_martians = 1
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.icmp_ignore_bogus_error_responses = 1
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_rfc1337 = 1
-net.ipv6.conf.all.accept_redirects = 0
-net.ipv6.conf.default.accept_redirects = 0
-net.ipv6.conf.all.accept_source_route = 0
-net.ipv6.conf.default.accept_source_route = 0
EOF

echo "== unused kernel modules"
put etc/modprobe.d/vaevictis-hardening.conf <<'EOF'
# VaeVictis: network protocols and file systems nobody needs on a desktop (generated by vv-secure).
# Each one has a long history of kernel bugs. "install ... /bin/false" blocks loading, even on demand.
install dccp /bin/false
install sctp /bin/false
install rds /bin/false
install tipc /bin/false
install ax25 /bin/false
install netrom /bin/false
install rose /bin/false
install cramfs /bin/false
install freevxfs /bin/false
install jffs2 /bin/false
# FireWire allows direct memory access (DMA) from the cable
install firewire-core /bin/false
EOF

echo "== core dumps"
put etc/systemd/coredump.conf.d/10-vaevictis.conf <<'EOF'
[Coredump]
Storage=none
ProcessSizeMax=0
EOF
put etc/security/limits.d/10-vaevictis-nocore.conf <<'EOF'
* hard core 0
EOF

echo "== panic button (GUI as the normal user + one tiny root helper)"
if [ -f "$HERE/vv-panic" ] && [ -f "$HERE/vv-panic-action" ]; then
    for f in usr/local/bin/vv-panic etc/sudoers.d/99-vv-panic etc/sysctl.d/99-panic.conf; do bak "$CH/$f"; done
    install -D -m 0755 "$HERE/vv-panic"        "$CH/usr/local/bin/vv-panic"
    install -D -m 0755 "$HERE/vv-panic-action" "$CH/usr/local/libexec/vv-panic-action"
    tmp="$(mktemp)"
    printf '%s\n' '# VaeVictis panic button: one program, no arguments, no password (generated by vv-secure)' \
                   'ALL ALL=(root) NOPASSWD: /usr/local/libexec/vv-panic-action ""' > "$tmp"
    if command -v visudo >/dev/null 2>&1; then
        visudo -cf "$tmp" >/dev/null || { rm -f "$tmp"; die "the generated sudoers rule is invalid: nothing was installed for the panic button"; }
    else
        echo "  (visudo not found on this machine: sudoers syntax not checked)"
    fi
    install -D -m 0440 "$tmp" "$CH/etc/sudoers.d/99-vv-panic"; rm -f "$tmp"
    rm -f "$CH/etc/sysctl.d/99-panic.conf"        # old rule: kernel.sysrq = 1 switched on EVERY SysRq key for everyone
    put usr/share/applications/vv-panic.desktop <<'EOF'
[Desktop Entry]
Type=Application
Version=1.0
Name=Panic Mode
Comment=Cut the network and power off immediately
Exec=/usr/local/bin/vv-panic
Icon=vv-panic
Terminal=false
StartupNotify=false
Categories=System;
Keywords=panic;emergency;shutdown;
StartupWMClass=vv-panic
EOF
    echo "  /usr/local/bin/vv-panic, /usr/local/libexec/vv-panic-action, /etc/sudoers.d/99-vv-panic"
else
    echo "  skipped: put vv-panic and vv-panic-action next to this script to install the panic button"
fi

echo "== file permissions (only root has any business reading these)"
# dpkg-statoverride makes the mode survive package upgrades: without it, upgrading cron or ssh would reset it.
PERMS_SCRIPT=$(cat <<'EOS'
for spec in '0600 /etc/crontab' '0600 /etc/ssh/sshd_config' '0700 /etc/cron.d' '0700 /etc/cron.daily' \
            '0700 /etc/cron.hourly' '0700 /etc/cron.weekly' '0700 /etc/cron.monthly'; do
    mode=${spec%% *}; f=${spec#* }
    [ -e "$f" ] || continue
    dpkg-statoverride --remove "$f" >/dev/null 2>&1 || true
    dpkg-statoverride --update --add root root "$mode" "$f" && echo "  $mode $f"
done
EOS
)
in_chroot "$PERMS_SCRIPT"

echo "== inside the chroot"
in_chroot "
systemctl mask hibernate.target hybrid-sleep.target suspend-then-hibernate.target
systemctl enable apparmor.service 2>&1 | tail -1
dpkg -s apparmor >/dev/null 2>&1 && echo 'apparmor package: installed' || echo 'WARNING: apparmor package missing'
"

cat <<EOF

Done. Backups of replaced files: $BK (only if something was replaced)

Applied
  sysctl     hidden kernel pointers, restricted dmesg/BPF/ptrace/perf, no kexec, protected links, no redirects, martian packets logged
  files      crontab, cron directories and sshd_config readable by root only (kept across upgrades)
  modules    dccp sctp rds tipc ax25 netrom rose cramfs freevxfs jffs2 firewire-core cannot load
  core dumps off (kernel, systemd, PAM limits)
  sleep      hibernation masked (it would write RAM to disk); normal suspend still works
  panic      GUI as your user + a root helper allowed by one exact sudoers rule (not a root GUI)
These files live in the root file system, so a system installed from this ISO inherits them.
Boot options (ipv6.disable, init_on_free, ...) belong to the live boot menu: see vv-iso.

Left out ON PURPOSE (would break other people's PCs)
  kernel.unprivileged_userns_clone=0   breaks Firefox's sandbox, Flatpak, bubblewrap
  lockdown=confidentiality, module.sig_enforce   block unsigned drivers (NVIDIA!)
  mitigations=...,nosmt                halves the CPU threads
  hidepid=2, noexec on /tmp or /home   break desktop components and installers
  iommu=force                          crashes on some firmware
  kernel.modules_disabled=1            no module could load after boot: USB sticks, WireGuard, new drivers would stop working
  kernel.sysrq=0                       keeps the SysRq keys (Alt+SysRq+R E I S U B) to recover a frozen desktop; Panic enables only what it needs
  blacklisting usb-storage, bluetooth, thunderbolt, hfsplus   breaks everyday devices
EOF
