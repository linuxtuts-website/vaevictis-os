#!/bin/bash
# vv-grub-password - VaeVictis boot menu password (GRUB).
#
# VaeVictis starts normally WITHOUT this password. GRUB asks for it only when someone wants to change the start
# options (key "e") or open the GRUB console (key "c"): without it, anyone at the keyboard could start a shell
# that skips your login. The GRUB username is: grub
#
#   sudo vv-grub-password                   set a new password (asked twice) and update the boot menu
#   sudo vv-grub-password --status          say whether the password is set
#   vv-grub-password --safe-chars LAYOUT    print the characters that type the same in LAYOUT and at the boot menu
#   vv-grub-password --stdin [--layout L] [--no-update]
#                                           used by the installer: read the password from standard input (one line)
#
# The boot menu always reads the keyboard as US English, whatever your layout. A password is accepted only if every
# character is typed by the same key in your layout and in the US layout, so it works at the boot menu too.
# The hash (PBKDF2-SHA512, 210000 rounds) goes to /etc/grub.d/01_vaevictis_password (root only) and from there to
# /boot/grub/grub.cfg. /boot is NOT encrypted: use a password you do not use anywhere else.
# What it does not stop: someone who can start the computer from a USB stick can change /boot itself. A firmware
# (BIOS/UEFI) password and no booting from USB close that too.
set -euo pipefail

FILE=/etc/grub.d/01_vaevictis_password
GRUB_USER=grub
ITER=210000
MIN=8
MAX=1000                                               # GRUB reads at most 1023 characters
# Same key on US, QWERTZ and AZERTY keyboards: used when the layout cannot be checked
FALLBACK_SAFE=' BCDEFGHIJKLNOPRSTUVXbcdefghijklnoprstuvx'

die() { echo "vv-grub-password: $*" >&2; exit 1; }

# safe_chars LAYOUT: letters, digits and space that the SAME key types in LAYOUT and in the US layout (levels 1 and 2)
safe_chars() {
    local lay="${1:-us}" us lo
    lay="${lay%%,*}"
    if ! [[ "$lay" =~ ^[a-z]{2,10}$ ]] || ! command -v ckbcomp >/dev/null 2>&1 \
       || ! us=$(ckbcomp -layout us 2>/dev/null) || ! lo=$(ckbcomp -layout "$lay" 2>/dev/null); then
        printf '%s' "$FALLBACK_SAFE"; return 0
    fi
    awk '
        BEGIN { for (i = 32; i < 127; i++) { c = sprintf("%c", i); if (c ~ /^[A-Za-z0-9 ]$/) want[sprintf("U+%04x", i)] = c } }
        FNR == 1 { f++ }
        $1 == "keycode" && $3 == "=" && $2 + 0 >= 2 && $2 + 0 <= 57 {
            for (col = 4; col <= 5; col++) {
                s = $col; sub(/^\+/, "", s)
                if (f == 1) { us[$2 "," col] = s; continue }
                if (!(s in want)) continue
                if (us[$2 "," col] == s) good[s] = 1; else bad[s] = 1
            }
        }
        END { for (i = 32; i < 127; i++) { k = sprintf("U+%04x", i); if ((k in good) && !(k in bad)) printf "%s", want[k] } }
    ' <(printf '%s\n' "$us") <(printf '%s\n' "$lo")
}

# describe_safe CHARS: the same set in words, e.g. "letters except a m q w z A M Q W Z, no digits, spaces"
describe_safe() {
    local s="$1" l miss="" dmiss="" out
    for l in {a..z} {A..Z}; do [[ "$s" == *"$l"* ]] || miss+=" $l"; done
    for l in {0..9}; do [[ "$s" == *"$l"* ]] || dmiss+=" $l"; done
    if [ -z "$miss" ]; then out="letters a-z and A-Z"
    elif [ "${#miss}" -ge 104 ]; then out="no Latin letters"
    else out="letters except$miss"; fi
    if [ -z "$dmiss" ]; then out+=", digits"
    elif [ "${#dmiss}" -ge 20 ]; then out+=", no digits"
    else out+=", digits except$dmiss"; fi
    if [[ "$s" == *" "* ]]; then out+=", spaces"; else out+=", no spaces"; fi
    printf '%s' "$out"
}

# check PASSWORD SAFE: empty output = good, otherwise the reason
check() {
    local pw="$1" safe="$2" i
    [ "${#pw}" -ge "$MIN" ] || { echo "use at least $MIN characters"; return 0; }
    [ "${#pw}" -le "$MAX" ] || { echo "the boot menu reads at most $MAX characters"; return 0; }
    for ((i = 0; i < ${#pw}; i++)); do
        # the offending character is not shown: it is part of the password
        [[ "$safe" == *"${pw:i:1}"* ]] || { echo "it contains a character that the boot menu types differently (allowed: $(describe_safe "$safe"))"; return 0; }
    done
}

current_layout() {
    local l=""
    [ -f /etc/default/keyboard ] && l=$(sed -n 's/^XKBLAYOUT="\{0,1\}\([^",]*\).*/\1/p' /etc/default/keyboard | head -1)
    echo "${l:-us}"
}

write_file() {   # write_file PASSWORD
    local pw="$1" hash tmp
    command -v grub-mkpasswd-pbkdf2 >/dev/null 2>&1 || die "grub-mkpasswd-pbkdf2 is missing (package grub-common)."
    hash=$(printf '%s\n%s\n' "$pw" "$pw" | grub-mkpasswd-pbkdf2 -c "$ITER" 2>/dev/null \
           | grep -o 'grub\.pbkdf2\.sha512\.[0-9]*\.[0-9A-F]*\.[0-9A-F]*' | tail -1) || true
    [ -n "$hash" ] || die "could not compute the password hash."
    install -d -m 0755 /etc/grub.d
    tmp=$(mktemp /etc/.vv-grub-password.XXXXXX)
    cat > "$tmp" <<EOF
#!/bin/sh
# VaeVictis boot menu password, written by vv-grub-password. Change it with: sudo vv-grub-password
# A normal start needs no password. Changing the start options or opening the GRUB console asks for
# user "$GRUB_USER" and this password.
exec cat <<'GRUBEOF'
set superusers="$GRUB_USER"
password_pbkdf2 $GRUB_USER $hash
# every boot entry (also "Advanced options", other systems, firmware setup) starts without the password
menuentry_id_option="--unrestricted \$menuentry_id_option"
export menuentry_id_option
GRUBEOF
EOF
    chown root:root "$tmp"; chmod 0700 "$tmp"
    mv -f "$tmp" "$FILE"
}

update_menu() {
    command -v update-grub >/dev/null 2>&1 || die "update-grub is missing: the password is saved but not active yet."
    update-grub
    local cfg=/boot/grub/grub.cfg
    grep -q "^password_pbkdf2 $GRUB_USER grub\.pbkdf2\.sha512\." "$cfg" && grep -q -- '--unrestricted' "$cfg" \
        || die "$cfg does not contain the password: it is NOT active. Run: sudo update-grub"
    chmod 0600 "$cfg"
    echo "Boot menu password active. Username: $GRUB_USER"
}

case "${1:-}" in --safe-chars|--describe|-h|--help) ;; *) [ "$(id -u)" -eq 0 ] || die "run it as root: sudo vv-grub-password" ;; esac

LAYOUT=""; UPDATE=1; MODE=interactive
while [ $# -gt 0 ]; do
    case "$1" in
        --safe-chars) safe_chars "${2:-us}"; echo; exit 0 ;;
        --describe)   describe_safe "$(safe_chars "${2:-us}")"; echo; exit 0 ;;
        --status)     if [ -x "$FILE" ] && grep -qs "^password_pbkdf2 $GRUB_USER " /boot/grub/grub.cfg; then
                          echo "Boot menu password: set (username $GRUB_USER)."
                      else echo "Boot menu password: NOT set. Set it with: sudo vv-grub-password"; exit 1; fi
                      exit 0 ;;
        --stdin)      MODE=stdin ;;
        --layout)     LAYOUT="${2:-}"; shift ;;
        --no-update)  UPDATE=0 ;;
        -h|--help)    sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)            die "unknown option: $1 (see --help)" ;;
    esac
    shift
done
LAYOUT="${LAYOUT:-$(current_layout)}"
SAFE="$(safe_chars "$LAYOUT")"

if [ "$MODE" = stdin ]; then
    IFS= read -r PW || [ -n "${PW:-}" ] || die "no password on standard input."
    why=$(check "$PW" "$SAFE"); [ -z "$why" ] || die "$why."
    write_file "$PW"; unset PW
    [ "$UPDATE" -eq 0 ] || update_menu
    exit 0
fi

echo "Boot menu (GRUB) password. VaeVictis starts normally without it: it is asked only to change the start"
echo "options or open the GRUB console. Username at the boot menu: $GRUB_USER"
echo "Use a password you do not use anywhere else (its hash is on the unencrypted /boot)."
echo "Keyboard layout: $LAYOUT. At the boot menu you can use: $(describe_safe "$SAFE")."
while true; do
    read -rsp "New boot menu password: " P1; echo
    read -rsp "Confirm: " P2; echo
    why=$(check "$P1" "$SAFE"); [ -z "$why" ] || { echo "Not accepted: $why."; continue; }
    [ "$P1" = "$P2" ] || { echo "The two passwords do not match."; continue; }
    break
done
write_file "$P1"; unset P1 P2
[ "$UPDATE" -eq 0 ] || update_menu
