case "${1:-}" in
    status) sanity; echo "chroot: $CH"; m="$(mounts)"; [ -n "$m" ] && echo "$m" || echo "no mounts" ;;
    mount)  do_mount ;;
    umount) do_umount ;;
    run)    shift; [ $# -gt 0 ] || die "usage: vv-chroot run COMMAND [ARGS...]"; run_inside "$@" ;;
    enter)  run_inside /bin/bash -l ;;
    audit)  cmd_audit ;;
    seal)   cmd_seal ;;
    lang)   cmd_lang ;;
    login)  cmd_login ;;
    has)    shift; cmd_has "$@" ;;
    sim)    shift; cmd_sim "$@" ;;
    pkgcheck) cmd_pkgcheck "${2:-}" ;;
    *)      sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
