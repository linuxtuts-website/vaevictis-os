            case "$l" in
                "## "*) printf '\n  %s\n' "${l#\#\# }" ;;
                *)  p="${l%%|*}"; w="${l#*|}"
                    if [ "$(dpkg-query --admindir="$CH/var/lib/dpkg" -W -f='${db:Status-Abbrev}' "$p" 2>/dev/null | cut -c1-2)" = "ii" ]; then
                        printf '    yes   %-28s %s\n' "$p" "$w"
                    else
                        printf '    NO    %-28s %s\n' "$p" "$w"; miss+=("$p")
                    fi ;;
            esac
        done
    }
    echo "== CORE: needed for a fully working desktop"; scan CORE missing_core
    echo; echo "== OPTIONAL: extras"; scan OPT missing_opt

    echo; echo "== Do your apps start? (imports tested inside the chroot)"
    cat > "$CH/tmp/vv_import_check.py" <<'PYEND'
import importlib
def try_import(*names):
    for n in names:
        try:
            importlib.import_module(n); return True
        except Exception:
            pass
    return False
checks = [
    ("Aurora",   try_import("PyQt6.QtWidgets") and try_import("PyQt6.QtMultimedia") and try_import("mutagen")),
    ("PDF Tool", try_import("PyQt6.QtWidgets") and try_import("pymupdf", "fitz")),
    ("Linpaint", try_import("tkinter") and try_import("PIL.ImageTk") and try_import("gi")),
    ("VPN, HIDS", try_import("gi")),
]
for name, ok in checks:
    print("    %-4s  %s" % ("yes" if ok else "NO", name))
PYEND
    if [ -n "${VV_SKIP_CHROOT:-}" ]; then echo "    [skipped in test]"; else run_inside python3 /tmp/vv_import_check.py; fi
    rm -f "$CH/tmp/vv_import_check.py"

    echo
    if [ "${#missing_core[@]}" -gt 0 ]; then
        echo "Missing CORE packages (${#missing_core[@]}). Simulate first (also validates the names), then install:"
        echo "  ./vv-chroot run apt-get update      (needed after 'seal': it empties the package lists)"
        echo "  ./vv-chroot pkgcheck --size"
        echo "  ./vv-chroot run apt-get install --no-install-recommends ${missing_core[*]}"
        if [ "$want_size" = 1 ] && [ -z "${VV_SKIP_CHROOT:-}" ]; then
            echo; echo "Simulation (nothing is installed):"
            cat > "$CH/tmp/vv_size.py" <<'PYEND'
import subprocess, sys
r = subprocess.run(["apt-get", "-s", "install", "--no-install-recommends", *sys.argv[1:]], capture_output=True, text=True)
for ln in (r.stdout + r.stderr).splitlines():
    if ln.startswith("E:") or "Unable to locate" in ln:
        print("    " + ln)
if "Unable to locate" in (r.stdout + r.stderr):
    print("    hint: the package lists are empty ('seal' removes them). Run first:  ./vv-chroot run apt-get update")
pk = [ln.split()[1] for ln in r.stdout.splitlines() if ln.startswith("Inst ")]
dl = inst = 0
for p in pk:
    block = subprocess.run(["apt-cache", "show", p], capture_output=True, text=True).stdout.split("\n\n")[0]
    for ln in block.splitlines():
        if ln.startswith("Size:"):
            dl += int(ln.split()[1])
        elif ln.startswith("Installed-Size:"):
            inst += int(ln.split()[1])
print("    %d packages (requested + dependencies): download about %.0f MB, installed about %.0f MB"
      % (len(pk), dl / 1e6, inst / 1024))
print("    the ISO grows less than the installed size: it is compressed")
PYEND
            run_inside python3 /tmp/vv_size.py "${missing_core[@]}"
            rm -f "$CH/tmp/vv_size.py"
        fi
    else
        echo "All CORE packages are installed."
    fi
    if [ "${#missing_opt[@]}" -gt 0 ]; then
        echo; echo "Optional extras you may want:  ${missing_opt[*]}"
    fi
}

cmd_login() {
    sanity
    local p="$CH/etc/dconf/profile/gdm" f d="$CH/etc/dconf/db/gdm.d"
    echo "== login screen logo"
    if [ -f "$p" ]; then echo "  /etc/dconf/profile/gdm:"; sed 's/^/      /' "$p"
    else echo "  no /etc/dconf/profile/gdm (the vendor profile under /usr/share/dconf/profile applies)"; fi
    echo "  files in gdm.d (the LAST one wins):"
    for f in $(ls "$d" 2>/dev/null | sort); do printf '      %-22s %s\n' "$f" "$(grep -h '^logo=' "$d/$f" 2>/dev/null | head -1)"; done
    [ -f "$CH/etc/dconf/db/gdm" ] || echo "  !! the compiled database /etc/dconf/db/gdm is MISSING: run ./vv-branding"
    if [ -f "$CH/etc/dconf/db/gdm" ] && [ -n "$(find "$d" -type f -newer "$CH/etc/dconf/db/gdm" 2>/dev/null)" ]; then
        echo "  !! the compiled database is OLDER than its source files: run ./vv-branding (it runs dconf update)"; fi
    echo "  Debian's own profile /usr/share/dconf/profile/gdm:"
    if [ -f "$CH/usr/share/dconf/profile/gdm" ]; then sed 's/^/      /' "$CH/usr/share/dconf/profile/gdm"; else echo "      (none)"; fi
    ls -l "$CH/usr/share/dconf/profile/" 2>/dev/null | awk 'NR>1 && $9 != "" {print "      " $9 " " $10 " " $11}' || true
    echo "  where Debian sets the logo:"
    local lg
    for lg in "$CH/etc/gdm3/greeter.dconf-defaults" "$CH/usr/share/gdm/greeter.dconf-defaults"; do
        if [ -f "$lg" ]; then printf '      %s:\n' "${lg#"$CH"}"; grep -n 'logo' "$lg" | sed 's/^/          /' || true
        else echo "      ${lg#"$CH"}: does not exist"; fi
    done
    echo "  /usr/share/gdm/dconf:"; ls -l "$CH/usr/share/gdm/dconf" 2>/dev/null | awk 'NR>1 && $9 != "" {print "      " $9 " " $10 " " $11}' || true
    echo "  compiled databases:"
    ls -l "$CH/etc/dconf/db" "$CH/var/lib/gdm3" 2>/dev/null | awk '$9 ~ /gdm|greeter/ {print "      " $9 "  " $5 " byte  " $6 " " $7 " " $8}' || true
    if [ -s "$CH/var/lib/gdm3/.config/dconf/user" ]; then
        echo "  !! the greeter user (Debian-gdm) has its own settings file: it outranks every other layer"; fi
    if [ -z "${VV_SKIP_CHROOT:-}" ]; then
        echo "  EFFECTIVE logo value, as dconf resolves it:"
        run_inside sh -c 'for p in gdm Debian-gdm; do v=$(DCONF_PROFILE=$p dconf read /org/gnome/login-screen/logo 2>&1); printf "      profile %-10s %s\n" "$p" "${v:-<not set>}"; done' 2>&1 | grep -v '^clean:' || true
    fi
    echo "== accounts (uid 1000 and up)"
    awk -F: '$3>=1000 && $3<60000 {print "  " $1 " (uid " $3 ")"}' "$CH/etc/passwd"
    echo "  root: $(awk -F: '$1=="root"{print ($2 ~ /^[!*]/) ? "locked" : "HAS A PASSWORD HASH"}' "$CH/etc/shadow" 2>/dev/null)"
    echo "== automatic login"
    grep -Hn '^AutomaticLogin' "$CH"/etc/gdm3/daemon.conf "$CH"/etc/gdm3/custom.conf 2>/dev/null | sed "s#$CH##; s/^/  active: /" || true
    { ls "$CH"/etc/live/config.conf.d/ 2>/dev/null || true; } | sed 's/^/  live-config settings: /'
    [ -L "$CH/etc/systemd/system/multi-user.target.wants/vv-live-session.service" ] \
        && echo "  vv-live-session.service: installed and enabled" || echo "  vv-live-session.service: NOT enabled (run ./vv-liveuser --apply)"
    for f in "$CH"/etc/sudoers.d/*; do if [ -f "$f" ]; then echo "  sudoers.d: $(basename "$f")"; fi; done
    return 0
}

cmd_has() {
    sanity
    [ $# -gt 0 ] || die "usage: vv-chroot has PACKAGE..."
    local p v
    for p in "$@"; do
        v="$(dpkg-query --admindir="$CH/var/lib/dpkg" -W -f='${db:Status-Abbrev}|${Version}' "$p" 2>/dev/null || true)"
        case "$v" in
            ii*) printf '  yes   %-26s %s\n' "$p" "${v#*|}" ;;
            *)   printf '  NO    %s\n' "$p" ;;
        esac
    done
}

