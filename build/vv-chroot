#!/usr/bin/env bash
# vv-chroot - safe mount / run / umount wrapper for the VaeVictis build chroot
#
#   vv-chroot status             show mounts under the chroot
#   vv-chroot mount | umount     manual control (umount also removes the temporary resolv.conf)
#   vv-chroot run CMD [ARGS]     mount, run CMD inside the chroot, ALWAYS unmount afterwards
#   vv-chroot enter              interactive shell, unmounts when you exit
#   vv-chroot audit              read-only report of what still needs fixing (no mounts needed)
#   vv-chroot seal               final cleanup before building the ISO (machine-id, SSH keys, history, logs...)
#   vv-chroot lang               list lines that still contain Italian in scripts and launchers
#   vv-chroot pkgcheck [--size]  what a fully working desktop still lacks (fonts, codecs, firmware...)
#   vv-chroot has PKG...         is each package installed? (and which version)
#   vv-chroot sim PKG...         how big would installing these packages be? (nothing is installed)
#   vv-chroot login              read-only report: login screen logo, accounts, automatic login
#
# Override the location with:  VV_CHROOT=/other/path vv-chroot ...
set -euo pipefail

HERE="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
CH="${VV_CHROOT:-/run/media/user/Mio/Backup_VaeVictis_Completo/vaevictis/new/chroot}"
CH="$(realpath -m "$CH")"
[ "$(id -u)" -eq 0 ] || exec sudo -E VV_CHROOT="$CH" "$0" "$@"

die() { echo "vv-chroot: $*" >&2; exit 1; }

sanity() {
    [ "$CH" != "/" ] && [ -f "$CH/etc/debian_version" ] && [ -d "$CH/usr" ] \
        || die "not a Debian root filesystem: $CH"
}

mounts() { awk -v p="$CH/" 'index($5, p) == 1 { print $5 }' /proc/self/mountinfo; }

all_mounted() {
    local d
    for d in dev dev/pts proc sys; do mountpoint -q "$CH/$d" || return 1; done
}

holders() {   # processes whose root or working directory is inside the chroot
    local p t found=0
    for p in /proc/[0-9]*; do
        for t in cwd root; do
            case "$(readlink "$p/$t" 2>/dev/null)" in
                "$CH"|"$CH"/*) echo "  pid ${p#/proc/}  $(cat "$p/comm" 2>/dev/null)  ($t)"; found=1; break ;;
            esac
        done
    done
    [ "$found" = 1 ] || echo "  (no process has its root or cwd there: something holds a file open)"
}

do_mount() {   # idempotent: mounts only the pieces that are missing
    sanity
    mountpoint -q "$CH/dev" || { mount --bind /dev "$CH/dev"; mount --make-rslave "$CH/dev"; }
    mkdir -p "$CH/dev/pts"
    mountpoint -q "$CH/dev/pts" || mount --bind /dev/pts "$CH/dev/pts"
    mountpoint -q "$CH/proc"    || mount -t proc proc "$CH/proc"
    mountpoint -q "$CH/sys"     || mount -t sysfs sys "$CH/sys"
    if [ -L "$CH/etc/resolv.conf" ]; then    # keep a symlink safe while we borrow the host DNS
        mv -T "$CH/etc/resolv.conf" "$CH/etc/resolv.conf.vv-orig"
    fi
    cp --remove-destination /etc/resolv.conf "$CH/etc/resolv.conf"
}

do_umount() {
    sanity
    local d
    for d in dev proc sys; do
        if mountpoint -q "$CH/$d"; then
            if ! umount -R "$CH/$d" 2>/dev/null; then
                echo "vv-chroot: $d is busy. Processes still inside the chroot:" >&2
                holders >&2
                echo "vv-chroot: detaching $d lazily (safe: it is a virtual file system)." >&2
                umount -R -l "$CH/$d" || true
            fi
        fi
    done
    rm -f "$CH/etc/resolv.conf"              # never ship the host's DNS settings
    if [ -e "$CH/etc/resolv.conf.vv-orig" ] || [ -L "$CH/etc/resolv.conf.vv-orig" ]; then
        mv -T "$CH/etc/resolv.conf.vv-orig" "$CH/etc/resolv.conf"
    fi
    local left; left="$(mounts)"
    if [ -n "$left" ]; then
        echo "STILL MOUNTED (do NOT move or delete the chroot):" >&2
        echo "$left" >&2
        return 1
    fi
    echo "clean: no mounts left under the chroot"
}

run_inside() {                                # run_inside CMD...   (mounts if needed, always unmounts)
    sanity
    local we_mounted=0 rc=0
    if ! all_mounted; then
        [ -z "$(mounts)" ] || echo "vv-chroot: leftover partial mounts found, completing them (they are unmounted at the end)" >&2
        do_mount; we_mounted=1
        trap 'do_umount || true; exit 130' INT TERM
    fi
    local envv=(HOME=/root TERM="${TERM:-xterm}" LANG=C.UTF-8 LC_ALL=C.UTF-8
                PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
                PS1='(vv-chroot) \w # ')
    [ -n "${DEBIAN_FRONTEND:-}" ] && envv+=(DEBIAN_FRONTEND="$DEBIAN_FRONTEND")
    set +e
    chroot "$CH" /usr/bin/env -i "${envv[@]}" "$@"
    rc=$?
    set -e
    if [ "$we_mounted" = 1 ]; then
        trap - INT TERM
        if ! do_umount; then rc=$(( rc == 0 ? 1 : rc )); fi
    fi
    return "$rc"
}

cmd_audit() {
    sanity
    set +e                                   # a report: one missing file must not stop the rest
    local hdr p st
    hdr() { printf '\n== %s\n' "$*"; }
    pkg() { dpkg-query --admindir="$CH/var/lib/dpkg" -W -f='${db:Status-Abbrev}' "$1" 2>/dev/null || true; }

    hdr "Base"
    ( . "$CH/etc/os-release" 2>/dev/null && echo "  $PRETTY_NAME" ) || true
    echo "  size on disk: $(du -xsh "$CH" 2>/dev/null | cut -f1)"

    hdr "Kernels / initramfs in /boot"
    ls -1 "$CH/boot" 2>/dev/null | grep -E '^(vmlinuz|initrd)' | sed 's/^/  /' || echo "  none"
    for p in vmlinuz vmlinuz.old initrd.img initrd.img.old; do
        [ -L "$CH/$p" ] && echo "  /$p -> $(readlink "$CH/$p")"
    done

    hdr "Key packages"
    for p in live-boot live-config live-config-systemd systemd-sysv network-manager gdm3 gnome-core \
             nftables wireguard-tools openresolv unattended-upgrades pkexec polkitd \
             python3-gi python3-tk python3-pil python3-pil.imagetk \
             xdg-desktop-portal-gnome gnome-screenshot firefox-esr tor locales keyboard-configuration; do
        st="$(pkg "$p")"
        case "$st" in ii*) printf '  yes   %s\n' "$p" ;; *) printf '  NO    %s\n' "$p" ;; esac
    done

    hdr "Enabled services"
    systemctl --root="$CH" list-unit-files --state=enabled --no-legend --no-pager 2>/dev/null \
        | awk '{print "  " $1}' || echo "  (could not read)"

    hdr "Accounts"
    awk -F: '$3>=1000 && $3<60000 {print "  user: " $1 " (uid " $3 ") home=" $6}' "$CH/etc/passwd"
    awk -F: '$1=="root" {print "  root password: " (($2 ~ /^[!*]/) ? "locked" : "SET (hash present)")}' "$CH/etc/shadow"
    echo "  /home: $(ls -A "$CH/home" 2>/dev/null | tr '\n' ' ')"

    hdr "Things that should NOT ship in an image"
    if [ -s "$CH/etc/machine-id" ]; then
        echo "  machine-id is set ($(cat "$CH/etc/machine-id")): empty it so every boot gets its own"
    else
        echo "  ok    machine-id empty/absent"
    fi
    if ls "$CH"/etc/ssh/ssh_host_* >/dev/null 2>&1; then
        echo "  SSH host keys present (every copy of the ISO would share them): $(ls "$CH"/etc/ssh/ssh_host_* | wc -l) files"
    else
        echo "  ok    no SSH host keys"
    fi
    find "$CH/root" "$CH/home" -maxdepth 3 \( -name '.bash_history' -o -name '.python_history' \
        -o -name '.viminfo' -o -name '.lesshst' \) 2>/dev/null | sed 's/^/  history file: /'
    if [ -L "$CH/etc/resolv.conf" ]; then
        echo "  resolv.conf is a symlink -> $(readlink "$CH/etc/resolv.conf")"
    elif [ -s "$CH/etc/resolv.conf" ]; then
        echo "  resolv.conf has content: $(grep -E '^nameserver' "$CH/etc/resolv.conf" | tr '\n' ' ')"
    else
        echo "  ok    no resolv.conf content"
    fi
    [ -e "$CH/var/lib/systemd/random-seed" ] && echo "  random-seed present (shared by every copy): seal removes it"
    [ -e "$CH/var/lib/systemd/credential.secret" ] && echo "  credential.secret present (shared secret): seal removes it"
    ls "$CH"/etc/NetworkManager/system-connections 2>/dev/null | sed 's/^/  NetworkManager profile (may hold Wi-Fi passwords): /'
    [ -n "$(ls -A "$CH/var/lib/bluetooth" 2>/dev/null)" ] && echo "  paired Bluetooth devices stored in /var/lib/bluetooth"
    if [ -d "$CH/etc/wireguard" ] && [ -n "$(ls -A "$CH/etc/wireguard" 2>/dev/null)" ]; then
        echo "  WireGuard configs inside the image: $(ls "$CH/etc/wireguard" | tr '\n' ' ')  <- PRIVATE KEYS would ship"
    fi
    ls "$CH"/etc/apt/*.bak "$CH"/etc/apt/sources.list.d/*.bak 2>/dev/null | sed 's/^/  backup file: /' || true
    echo "  apt cache: $(du -sh "$CH/var/cache/apt" 2>/dev/null | cut -f1), apt lists: $(du -sh "$CH/var/lib/apt/lists" 2>/dev/null | cut -f1), logs: $(du -sh "$CH/var/log" 2>/dev/null | cut -f1)"
    [ -z "$(ls -A "$CH/tmp" 2>/dev/null)" ] || echo "  /tmp is not empty: $(ls -A "$CH/tmp" | head -5 | tr '\n' ' ')"

    hdr "Locale, time zone, keyboard, hostname"
    echo "  /etc/default/locale: $(cat "$CH/etc/default/locale" 2>/dev/null | tr '\n' ' ')"
    echo "  locale.gen (active): $(grep -E '^[^#[:space:]]' "$CH/etc/locale.gen" 2>/dev/null | tr '\n' ' ')"
    echo "  timezone: $(cat "$CH/etc/timezone" 2>/dev/null || readlink "$CH/etc/localtime" 2>/dev/null)"
    echo "  keyboard: $(grep -E '^XKBLAYOUT' "$CH/etc/default/keyboard" 2>/dev/null)"
    echo "  hostname: $(cat "$CH/etc/hostname" 2>/dev/null)"

    hdr "VaeVictis components"
    ls -l "$CH"/usr/local/bin "$CH"/usr/local/libexec 2>/dev/null | sed 's/^/  /' || true
    ls "$CH"/usr/share/applications/vv-*.desktop 2>/dev/null | sed 's/^/  /' || true
    echo "  /etc/skel: $(ls -A "$CH/etc/skel" 2>/dev/null | tr '\n' ' ')"
    [ -f "$CH/usr/share/polkit-1/actions/org.vaevictis.vpn.policy" ] \
        && echo "  yes   polkit policy for vv-vpn" || echo "  NO    polkit policy for vv-vpn (asks for the password every time)"
    [ -d "$CH/var/lib/vv-vpn" ] && echo "  yes   /var/lib/vv-vpn" || echo "  NO    /var/lib/vv-vpn"
    if [ -f "$CH/etc/nftables.conf" ]; then
        echo "  nftables.conf: $(grep -cve '^[[:space:]]*\(#\|$\)' "$CH/etc/nftables.conf") active lines; service: $(systemctl --root="$CH" is-enabled nftables.service 2>/dev/null || echo unknown)"
    else
        echo "  NO /etc/nftables.conf"
    fi

    hdr "Build / test tools on THIS machine"
    for p in mksquashfs xorriso grub-mkrescue mformat qemu-system-x86_64; do
        if command -v "$p" >/dev/null 2>&1; then printf '  yes   %s\n' "$p"; else printf '  NO    %s\n' "$p"; fi
    done
    [ -d /usr/lib/grub/i386-pc ] && echo "  yes   grub BIOS modules" || echo "  NO    grub BIOS modules (grub-pc-bin)"
    [ -d /usr/lib/grub/x86_64-efi ] && echo "  yes   grub UEFI modules" || echo "  NO    grub UEFI modules (grub-efi-amd64-bin)"
    local ovmf=""
    for p in /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/OVMF/OVMF_CODE.fd \
             /usr/share/edk2/ovmf/OVMF_CODE.fd /usr/share/edk2/x64/OVMF_CODE.4m.fd; do
        if [ -f "$p" ]; then ovmf="$p"; break; fi
    done
    if [ -n "$ovmf" ]; then echo "  yes   UEFI firmware for QEMU: $ovmf"; else echo "  NO    OVMF (package: ovmf)"; fi
    [ -e /dev/kvm ] && echo "  yes   /dev/kvm (fast VM)" || echo "  NO    /dev/kvm (QEMU would be slow)"
    echo
}

cmd_seal() {
    sanity
    [ -z "$(mounts)" ] || die "mounts still present: run 'vv-chroot umount' first"
    local h
    say() { echo "  - $*"; }
    echo "Sealing $CH"
    : > "${CH:?}/etc/machine-id";                                  say "machine-id emptied (new one at every boot)"
    mkdir -p "$CH/var/lib/dbus"; ln -sfn /etc/machine-id "$CH/var/lib/dbus/machine-id"
    rm -f "$CH"/etc/ssh/ssh_host_*;                                say "SSH host keys removed"
    rm -f "$CH/var/lib/systemd/random-seed" "$CH/var/lib/systemd/credential.secret"; say "systemd random-seed / credential secret removed"
    rm -f "$CH"/root/.bash_history "$CH"/root/.python_history "$CH"/root/.viminfo "$CH"/root/.lesshst
    for h in "$CH"/home/*; do
        [ -d "$h" ] && rm -f "$h"/.bash_history "$h"/.python_history "$h"/.viminfo "$h"/.lesshst
    done;                                                          say "shell/editor history removed (root and /home/*)"
    find "$CH/tmp" "$CH/var/tmp" -mindepth 1 -delete 2>/dev/null || true; say "/tmp and /var/tmp emptied"
    find "$CH/var/lib/apt/lists" -type f ! -name lock -delete 2>/dev/null || true
    rm -f "$CH"/var/cache/apt/*.bin "$CH"/var/cache/apt/archives/*.deb;  say "apt lists and cache emptied (run 'apt update' after install)"
    find "$CH/var/log" -type f \( -name '*.gz' -o -name '*.[0-9]' -o -name '*.old' \) -delete 2>/dev/null || true
    find "$CH/var/log" -type f -exec truncate -s0 {} + 2>/dev/null || true
    rm -rf "$CH"/var/log/journal/* ;                               say "logs emptied (login records included)"
    rm -f "$CH"/var/lib/NetworkManager/secret_key "$CH"/var/lib/NetworkManager/*.lease \
          "$CH"/var/lib/NetworkManager/seen-bssids "$CH"/var/lib/NetworkManager/timestamps \
          "$CH"/var/lib/dhcp/*.leases "$CH"/var/lib/fail2ban/fail2ban.sqlite3; say "NetworkManager/DHCP/fail2ban state removed"
    rm -f "$CH"/etc/dpkg/*-old "$CH"/var/lib/dpkg/*-old "$CH"/var/cache/debconf/*-old
    echo "Done. Not touched on purpose: /etc/resolv.conf, NetworkManager profiles, user accounts. Check them with: vv-chroot audit"
}

cmd_lang() {
    sanity
    # Words that are Italian and nothing else (plus accented letters), so English code does not match.
    local pat='[àèéìòù]|\b(errore|attenzione|avviso|conferma|confermi|premi|scegli|seleziona|utente|annulla|salva|salvataggio|apri|chiudi|esci|nessun|nessuna|impostazioni|sistema|aggiorna|aggiornamento|avvia|avvio|spegni|connesso|disconnesso|connessione|rete|chiave|cartella|trovato|trovata|riprova|attendere|attendi|operazione|completato|completata|riuscito|fallito|fallita|disattivato|attivato|sicurezza|installa|installazione|disco|partizione|riavvia|benvenuto|aiuto|guida|scarica|prima|dopo|oppure|senza|sono|della|dello|degli|delle|nella|nello|sulla|quando|ancora|perch[eé]|per[oò]|cio[eè])\b'
    local dirs=() d f
    for d in usr/local/bin usr/local/libexec usr/local/sbin etc/skel; do
        [ -d "$CH/$d" ] && dirs+=("$CH/$d")
    done
    # Launchers: only OUR files. System launchers belong to their packages and are translated on purpose.
    for d in usr/share/applications etc/xdg/autostart; do
        [ -d "$CH/$d" ] || continue
        while IFS= read -r f; do dirs+=("$f"); done < <(find "$CH/$d" -maxdepth 1 -type f \( -name 'vv-*' -o -name 'v-snap*' \
            -o -name 'aurora*' -o -name 'linpaint*' -o -name 'hids*' -o -name 'vaevictis*' -o -name 'sysctl-helper*' \))
    done
    [ -d "$HERE" ] && dirs+=("$HERE")
    echo "Scanning: our scripts and launchers in the chroot, and the project folder $HERE"
    # Skipped on purpose: translated entries of any .desktop file (Name[it]=..., Comment[fr]=...), saved web pages
    # (*_files folders), ISOs, backups and this script.
    local out
    out="$(grep -rInEi --exclude-dir='*_files' --exclude-dir=iso-out --exclude-dir=vv-backups --exclude-dir=__pycache__ \
              --exclude='*.iso' --exclude='*.md' --exclude='*.html' --exclude=vv-chroot --exclude=vv-branding "$pat" "${dirs[@]}" 2>/dev/null \
          | grep -vE '^[^:]+:[0-9]+:[A-Za-z0-9_-]+\[[^]]+\][[:space:]]*=' | sed "s#$CH/##" || true)"
    if [ -z "$out" ]; then echo "No Italian found."; return 0; fi
    echo "Files with Italian (count) and the first 3 lines of each:"
    echo "$out" | cut -d: -f1 | sort | uniq -c | sort -rn | while read -r n f; do
        echo; echo "  $f  ($n)"
        echo "$out" | grep -F "$f:" | head -3 | cut -c1-170 | sed 's/^[^:]*:/    line /'
    done
}

