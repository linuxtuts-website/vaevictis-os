#!/usr/bin/env bash
# vv-branding - icons, welcome window and login screen look for the VaeVictis chroot
#
#   vv-branding         apply (safe to repeat; replaced files are backed up next to the chroot)
#
# What it does
#   1. installs SVG icons (hicolor/scalable) for the VaeVictis apps (from build/icons, the VaeVictis-Dark drawings)
#   2. sets Icon= in the .desktop files of those apps (matched by their Exec line)
#   3. installs the vv-welcome file that sits next to this script (dark window, its own icon,
#      live security status) so the dock no longer shows a generic icon while it is open
#   4. removes the "debian 13" logo from the GDM login screen
#   5. system identity: os-release and issue say VaeVictis and point to https://vaevictisos.org
set -euo pipefail

HERE="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
CH="${VV_CHROOT:-/run/media/user/Mio/Backup_VaeVictis_Completo/vaevictis/new/chroot}"
CH="$(realpath -m "$CH")"
VVC="$HERE/vv-chroot"

die() { echo "vv-branding: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || exec sudo -E VV_CHROOT="$CH" "$0" "$@"
[ -f "$CH/etc/debian_version" ] && [ "$CH" != "/" ] || die "not a Debian root filesystem: $CH"
[ -x "$VVC" ] || [ -n "${VV_SKIP_CHROOT:-}" ] || die "vv-chroot must be next to this script ($VVC)"

BK="$(dirname "$CH")/vv-backups/$(date +%Y%m%d-%H%M%S)"
bak() { local rel="${1#$CH/}"; [ -e "$1" ] || return 0; mkdir -p "$BK"; (cd "$CH" && cp -a --parents "$rel" "$BK/"); }
in_chroot() {
    if [ -n "${VV_SKIP_CHROOT:-}" ]; then echo "  [skipped in test] $(echo "$1" | head -c 200)"; return 0; fi
    "$VVC" run /bin/sh -c "$1"
}

# ------------------------------------------------------------------ 1. icons
ICONDIR="$CH/usr/share/icons/hicolor/scalable/apps"
install -d -m 0755 "$ICONDIR"

# 1.3: the same drawings as the VaeVictis-Dark icon theme (build/icons), so the launchers look the same with any theme.
APPICONS="$HERE/icons/VaeVictis-Dark/scalable/apps"
for n in vv-aurora vv-linpaint vv-install vv-nvidia vv-snap vv-welcome vv-vpn vv-panic; do
    [ -f "$APPICONS/$n.svg" ] || die "missing icon: $APPICONS/$n.svg"
    install -m 0644 "$APPICONS/$n.svg" "$ICONDIR/$n.svg"
done
echo "== icons: 8 SVG files in /usr/share/icons/hicolor/scalable/apps"
# VaeVictis PDF is gone from 1.2 (Debian's PDF viewer is installed): no icon of a program that is not there
if [ -e "$ICONDIR/vv-pdf.svg" ]; then rm -f "$ICONDIR/vv-pdf.svg" && echo "  removed /usr/share/icons/hicolor/scalable/apps/vv-pdf.svg"; fi

# The XML editor (vv-xml) is gone from the image: LibreOffice is installed. Remove what an earlier build left behind,
# so the ISO has no launcher, icon or colour scheme of a program that is not there.
echo "== removed: vv-xml (XML editor)"
for f in usr/local/bin/vv-xml usr/local/bin/vaevictis-dark.xml \
         usr/share/applications/vv-xml.desktop usr/local/share/applications/vv-xml.desktop \
         etc/skel/Desktop/vv-xml.desktop etc/skel/.local/share/applications/vv-xml.desktop \
         usr/share/gtksourceview-4/styles/vaevictis-dark.xml \
         usr/share/icons/hicolor/scalable/apps/vv-xml.svg; do
    if [ -e "$CH/$f" ]; then rm -f "$CH/$f" && echo "  removed /$f"; fi
done

# The HIDS (file-integrity daemon) is gone from 1.1: it was the biggest piece of our own code always running as root.
# Remove what 1.0/1.0.1 builds installed, so the image carries no daemon, popup, launcher or log of it.
echo "== removed: HIDS (dropped in 1.1)"
rm -f "$CH/etc/systemd/system/multi-user.target.wants/sysctl-helper.service"
for f in usr/libexec/systemd-sysctl-helper var/log/hids_baseline.json; do
    [ -e "$CH/$f" ] && { chattr -i "$CH/$f" 2>/dev/null || true; }
done
for f in usr/libexec/systemd-sysctl-helper etc/systemd/system/sysctl-helper.service \
         usr/local/bin/hids-gui usr/local/bin/hids-notify etc/xdg/autostart/hids-notify.desktop \
         usr/share/applications/hids-security.desktop usr/share/icons/hicolor/scalable/apps/hids.svg \
         var/log/hids.log var/log/hids_baseline.json; do
    if [ -e "$CH/$f" ] || [ -L "$CH/$f" ]; then rm -f "$CH/$f" && echo "  removed /$f"; fi
done

# ------------------------------------------------------------------ 2. .desktop files
declare -A MAP=(
    [aurora]=vv-aurora          [linpaint]=vv-linpaint     [vaevictis_install]=vv-install
    [install-vaevictis]=vv-install  [vv-nvidia]=vv-nvidia
    [v-snap]=vv-snap            [vv-welcome]=vv-welcome    [vv-panic]=vv-panic   [vv-vpn]=vv-vpn
)
declare -A NAMEMAP=(
    ['^Name=.*vaevictis.*snap']=vv-snap
    ['^Name=.*vaevictis.*vpn']=vv-vpn      ['^Name=.*vaevictis.*install']=vv-install  ['^Name=.*vaevictis.*panic']=vv-panic
    ['^Name=aurora']=vv-aurora             ['^Name=lin ?paint']=vv-linpaint
)
echo "== .desktop files"
patched=0
for dir in usr/share/applications usr/local/share/applications etc/xdg/autostart etc/skel/Desktop etc/skel/.local/share/applications; do
    [ -d "$CH/$dir" ] || continue
    for f in "$CH/$dir"/*.desktop; do
        [ -f "$f" ] || continue
        exec_line="$(grep -m1 '^Exec=' "$f" || true)"; [ -n "$exec_line" ] || continue
        hit=0
        for key in "${!MAP[@]}"; do
            if echo "$exec_line" | grep -Eq "[ /=]${key}([ .\"'%]|$)"; then icon="${MAP[$key]}"; hit=1; break; fi
        done
        if [ "$hit" = 0 ]; then                 # fallback: the launcher's visible name
            name_line="$(grep -m1 '^Name=' "$f" || true)"
            for key in "${!NAMEMAP[@]}"; do
                if echo "$name_line" | grep -Eqi "$key"; then icon="${NAMEMAP[$key]}"; hit=1; break; fi
            done
        fi
        if [ "$hit" = 1 ]; then
            if grep -q '^Icon=' "$f"; then sed -i "s|^Icon=.*|Icon=$icon|" "$f"; else printf 'Icon=%s\n' "$icon" >> "$f"; fi
            echo "  ${f#$CH/}  ->  Icon=$icon"; patched=$((patched+1))
        elif grep -qi '^Name=.*vaevictis' "$f"; then
            echo "  NOT matched: ${f#$CH/}  (send me its Exec= line)"
        fi
    done
done
[ "$patched" -gt 0 ] || echo "  (no matching .desktop files found: check the Exec= lines of your launchers)"

# ------------------------------------------------------------------ 3. welcome window
echo "== welcome window"
bak "$CH/usr/local/bin/vv-welcome"
install -d -m 0755 "$CH/usr/local/bin"
[ -f "$HERE/vv-welcome" ] || die "vv-welcome must be next to this script ($HERE/vv-welcome)"
install -m 0755 "$HERE/vv-welcome" "$CH/usr/local/bin/vv-welcome"
bak "$CH/usr/share/applications/vv-welcome.desktop"
cat > "$CH/usr/share/applications/vv-welcome.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Version=1.0
Name=VaeVictis Welcome
Comment=Welcome to VaeVictis OS
Exec=/usr/local/bin/vv-welcome --force
Icon=vv-welcome
Terminal=false
NoDisplay=true
StartupWMClass=vv-welcome
Categories=Utility;
EOF

# Opens by itself ONCE per user: vv-welcome writes ~/.config/vaevictis/welcome-seen on its first start and exits
# silently afterwards. The autostart entry must NOT use --force (that always opens the window), and there must be
# only one such entry: remove any older one that starts vv-welcome (wherever it came from).
echo "== welcome: one autostart entry, no --force"
for d in etc/xdg/autostart etc/skel/.config/autostart; do
    [ -d "$CH/$d" ] || continue
    for f in "$CH/$d"/*.desktop; do
        [ -f "$f" ] || continue
        [ "$(basename "$f")" = "vv-welcome.desktop" ] && continue
        if grep -q '^Exec=.*vv-welcome' "$f"; then rm -f "$f"; echo "  removed ${f#$CH/}"; fi
    done
done
rm -f "$CH/etc/skel/.config/autostart/vv-welcome.desktop"
install -d -m 0755 "$CH/etc/xdg/autostart"
cat > "$CH/etc/xdg/autostart/vv-welcome.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Version=1.0
Name=VaeVictis Welcome
Exec=/usr/local/bin/vv-welcome
Icon=vv-welcome
Terminal=false
X-GNOME-Autostart-enabled=true
NoDisplay=true
EOF
echo "  /etc/xdg/autostart/vv-welcome.desktop  (Exec without --force)"

# ------------------------------------------------------------------ 4. login screen logo
echo "== top bar: removable drive icon (eject button) when a USB stick is plugged in"
install -d -m 0755 "$CH/etc/dconf/db/vaevictis.d" "$CH/etc/dconf/profile"
# enabled-extensions is ONE list: keep whatever other system defaults already enable and add ours
python3 - "$CH" <<'PYX'
import glob, re, sys
ch = sys.argv[1]
# drive-menu: eject button in the top bar. dash-to-dock: the dock also shows mounted USB sticks and disks
# (this is what made the stick appear in the tests; package gnome-shell-extension-dashtodock).
# blur-my-shell (1.3, package gnome-shell-extension-blur-my-shell, installed for vv-look): the wallpaper, blurred, behind
# the overview and the app grid.
exts = ["drive-menu@gnome-shell-extensions.gcampax.github.com", "dash-to-dock@micxgx.gmail.com", "blur-my-shell@aunetx"]
found = []
for pat in (ch + "/etc/dconf/db/*.d/*", ch + "/usr/share/glib-2.0/schemas/*.override"):
    for f in sorted(glob.glob(pat)):
        if f.endswith("10-extensions-vaevictis"):
            continue
        try:
            txt = open(f, errors="replace").read()
        except OSError:
            continue
        for m in re.finditer(r"^\s*enabled-extensions\s*=\s*\[(.*?)\]", txt, re.M):
            found += re.findall(r"'([^']+)'", m.group(1))
lst = []
for e in found + exts:
    if e not in lst:
        lst.append(e)
open(ch + "/etc/dconf/db/vaevictis.d/10-extensions-vaevictis", "w").write("[org/gnome/shell]\nenabled-extensions=%r\n" % lst)
print("  enabled-extensions default:", lst)
PYX
if [ ! -f "$CH/etc/dconf/profile/user" ]; then
    printf 'user-db:user\nsystem-db:vaevictis\n' > "$CH/etc/dconf/profile/user"
elif ! grep -q '^system-db:vaevictis' "$CH/etc/dconf/profile/user"; then
    sed -i '0,/^user-db:user.*/s//&\nsystem-db:vaevictis/' "$CH/etc/dconf/profile/user"
    grep -q '^system-db:vaevictis' "$CH/etc/dconf/profile/user" || printf 'system-db:vaevictis\n' >> "$CH/etc/dconf/profile/user"
fi
# A profile that lists a system database which does not exist makes EVERY program that reads settings log
# "unable to open file /etc/dconf/db/local ... expect degraded performance". Drop the lines of missing ones.
for n in local site; do
    [ -e "$CH/etc/dconf/db/$n" ] || sed -i "/^system-db:$n[[:space:]]*\$/d" "$CH/etc/dconf/profile/user"
done

# The boot screens (GRUB menu and Plymouth, style A) are made by vv-boot-theme, run after this script.

echo "== login screen: no Debian logo"
install -d -m 0755 "$CH/etc/dconf/profile" "$CH/etc/dconf/db/gdm.d"
# The login screen runs as the user "Debian-gdm", and Debian gives that user the dconf profile of the same name
# (a link to Debian's "gdm" profile, which has no system database). So BOTH names get Debian's own profile with our
# "gdm" system database added on top; Debian's settings underneath stay as they are.
GDMP="$(mktemp)"
if [ -f "$CH/usr/share/dconf/profile/gdm" ]; then cat "$CH/usr/share/dconf/profile/gdm" > "$GDMP"
else printf 'user-db:user\nfile-db:/var/lib/gdm3/greeter-dconf-defaults\n' > "$GDMP"; fi
grep -q '^system-db:gdm' "$GDMP" || sed -i '0,/^user-db:user.*/s//&\nsystem-db:gdm/' "$GDMP"
grep -q '^system-db:gdm' "$GDMP" || printf 'system-db:gdm\n' >> "$GDMP"
for n in gdm Debian-gdm; do
    bak "$CH/etc/dconf/profile/$n"
    install -m 0644 "$GDMP" "$CH/etc/dconf/profile/$n"
done
rm -f "$GDMP"
# The LAST file in gdm.d wins, so ours is named 99-: any other file that sets the logo (Debian ships one) loses.
rm -f "$CH/etc/dconf/db/gdm.d/10-vaevictis"
cat > "$CH/etc/dconf/db/gdm.d/99-vaevictis" <<'EOF'
[org/gnome/login-screen]
logo=''
EOF

# ------------------------------------------------------------------ 5. system identity
OS_ID="${VV_OS_ID:-vaevictis}"
echo "== system identity (os-release, issue)"
in_chroot "dpkg-divert --list /usr/lib/os-release | grep -q . || dpkg-divert --local --no-rename --divert /usr/lib/os-release.debian --add /usr/lib/os-release"
install -d -m 0755 "$CH/usr/lib"
bak "$CH/usr/lib/os-release"
cat > "$CH/usr/lib/os-release" <<EOF
PRETTY_NAME="VaeVictis OS"
NAME="VaeVictis OS"
VERSION_ID="1.2"
VERSION="1.2 (Hardened)"
VERSION_CODENAME=trixie
ID=$OS_ID
ID_LIKE=debian
HOME_URL="https://vaevictisos.org"
SUPPORT_URL="https://vaevictisos.org"
BUG_REPORT_URL="https://github.com/linuxtuts-website/vaevictis-os/security"
LOGO=vv-welcome
EOF
[ -L "$CH/etc/os-release" ] || cp "$CH/usr/lib/os-release" "$CH/etc/os-release"
printf 'VaeVictis OS \\n \\l\n\n' > "$CH/etc/issue"
printf 'VaeVictis OS\n' > "$CH/etc/issue.net"
if [ -f "$CH/etc/default/grub" ]; then
    if grep -q '^GRUB_DISTRIBUTOR=' "$CH/etc/default/grub"; then sed -i 's|^GRUB_DISTRIBUTOR=.*|GRUB_DISTRIBUTOR="VaeVictis"|' "$CH/etc/default/grub"
    else echo 'GRUB_DISTRIBUTOR="VaeVictis"' >> "$CH/etc/default/grub"; fi
fi
# ID_LIKE=debian and VERSION_CODENAME=trixie stay on purpose: apt, unattended-upgrades and GNOME rely on them.
# Safety net: if the automatic security updates no longer recognise the release, fall back to ID=debian.
if [ "$OS_ID" != "debian" ]; then
    if ! in_chroot "command -v unattended-upgrade >/dev/null 2>&1 || exit 0; out=\$(unattended-upgrade --dry-run -d 2>&1 | grep -i 'allowed origins' | head -1); echo \"  \$out\"; echo \"\$out\" | grep -q trixie"; then
        sed -i 's/^ID=.*/ID=debian/' "$CH/usr/lib/os-release"
        echo "  WARNING: unattended-upgrades did not recognise the release with ID=$OS_ID; fell back to ID=debian."
    fi
fi

echo "== translation fixes (launchers)"
for f in "$CH/usr/share/applications/v-snap.desktop" "$CH/etc/skel/Desktop/v-snap.desktop"; do
    if [ -f "$f" ] && grep -q 'Premi Invio per chiudere' "$f"; then
        sed -i 's/\[Premi Invio per chiudere\]/[Press Enter to close]/' "$f"; echo "  ${f#$CH/}"
    fi
done

# ------------------------------------------------------------------ in the chroot
echo "== inside the chroot: caches"
in_chroot "
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -f -t /usr/share/icons/hicolor || echo 'gtk-update-icon-cache not found (package libgtk-3-bin)'
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications || true
command -v dconf >/dev/null 2>&1 || apt-get install -y --no-install-recommends dconf-cli
dconf update && echo 'dconf database updated'
"

echo
echo "Done. Backups of replaced files: $BK (only if something was replaced)"
