#!/usr/bin/env bash
# vv-harden - hardened sshd + nftables firewall + fail2ban, written into the VaeVictis chroot
#
#   vv-harden           apply (safe to repeat; replaced files are backed up next to the chroot)
#   vv-harden rules     print the firewall rules that would be written
#
# Variables:  VV_CHROOT   chroot path
#             VV_SSH_PORT SSH port (default 2299)
set -euo pipefail

HERE="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
CH="${VV_CHROOT:-/run/media/user/Mio/Backup_VaeVictis_Completo/vaevictis/new/chroot}"
CH="$(realpath -m "$CH")"
SSH_PORT="${VV_SSH_PORT:-2299}"
VVC="$HERE/vv-chroot"

die() { echo "vv-harden: $*" >&2; exit 1; }
[[ "$SSH_PORT" =~ ^[0-9]+$ ]] && [ "$SSH_PORT" -ge 1024 ] && [ "$SSH_PORT" -le 65535 ] || die "VV_SSH_PORT must be 1024-65535"

V6_IN=""; V6_SET=""; V6_RATE=""
if [ "${VV_IPV6:-0}" = 1 ]; then      # only for systems that keep IPv6 on (the live boot options switch it off)
    V6_IN='        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept'
    V6_SET='    set ssh_rate6 {
        type ipv6_addr
        flags dynamic, timeout
        timeout 10m
    }'
    V6_RATE='        tcp dport @ssh_open ct state new update @ssh_rate6 { ip6 saddr limit rate over 4/minute burst 4 packets } drop'
fi

nft_rules() {
cat <<EOF
#!/usr/sbin/nft -f
# VaeVictis firewall (generated by vv-harden: edit the script variables, not this file)
#   in : drop everything except DHCP replies, the ICMP messages IPv4 needs, and SSH (port $SSH_PORT) ONLY while
#        ssh.service runs: the port is in the set ssh_open only then (added and removed by ssh.service itself, see
#        /etc/systemd/system/ssh.service.d/10-vaevictis-firewall.conf). Running "nft -f" on this file by hand empties
#        the set: restart ssh (or nftables, which puts the port back if ssh is running) to open it again.
#   out: nothing is blocked (any port, any server; only invalid packets are dropped)
# Only our own table is replaced, so libvirt and fail2ban keep their rules.
# IPv6 is switched off at boot (ipv6.disable=1): no IPv6 rules. Systems that keep IPv6: run vv-harden with VV_IPV6=1.

add table inet vv_filter
delete table inet vv_filter

table inet vv_filter {
    set ssh_open {
        type inet_service
    }
    set ssh_rate {
        type ipv4_addr
        flags dynamic, timeout
        timeout 10m
    }
$V6_SET

    chain input {
        type filter hook input priority filter; policy drop;
        iif "lo" accept
        ct state invalid drop
        # TCP flag combinations no real connection uses (scanners: NULL, XMAS, SYN+FIN, SYN+RST)
        tcp flags & (fin|syn|rst|psh|ack|urg) == 0x0 drop
        tcp flags & (fin|syn|rst|psh|ack|urg) == fin|psh|urg drop
        tcp flags & (fin|syn) == fin|syn drop
        tcp flags & (syn|rst) == syn|rst drop
        ct state established,related accept
        icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
        udp sport 67 udp dport 68 accept
$V6_IN
        # SSH: at most 4 new connections a minute from one address (fail2ban bans after 3 failed logins)
        tcp dport @ssh_open ct state new update @ssh_rate { ip saddr limit rate over 4/minute burst 4 packets } drop
$V6_RATE
        # Only from your own network, if you want: put it here, remove the "#", and add a "#" to the line after it
        # tcp dport @ssh_open ip saddr { 192.168.1.0/24 } ct state new accept
        tcp dport @ssh_open ct state new accept
        iifname "virbr*" meta l4proto { tcp, udp } th dport 53 accept
        iifname "virbr*" udp dport 67 accept
        limit rate 3/minute log prefix "vv-drop-in " level info
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        iifname "virbr*" accept
    }

    chain output {
        type filter hook output priority filter; policy accept;
        ct state invalid drop
    }
}
EOF
}

[ "${1:-}" = "rules" ] && { nft_rules | cat -s; exit 0; }

# (test mode, VV_SKIP_CHROOT=1, only writes into the folder given as VV_CHROOT: no root needed)
[ "$(id -u)" -eq 0 ] || [ -n "${VV_SKIP_CHROOT:-}" ] || exec sudo -E VV_CHROOT="$CH" VV_SSH_PORT="$SSH_PORT" VV_IPV6="${VV_IPV6:-0}" "$0" "$@"
[ -f "$CH/etc/debian_version" ] && [ "$CH" != "/" ] || die "not a Debian root filesystem: $CH"
[ -x "$VVC" ] || [ -n "${VV_SKIP_CHROOT:-}" ] || die "vv-chroot must be next to this script ($VVC)"

BK="$(dirname "$CH")/vv-backups/$(date +%Y%m%d-%H%M%S)"
bak() {                                  # keep the previous version of a file, outside the image
    local rel="${1#$CH/}"
    [ -e "$1" ] || return 0
    mkdir -p "$BK"; (cd "$CH" && cp -a --parents "$rel" "$BK/")
}
in_chroot() {
    if [ -n "${VV_SKIP_CHROOT:-}" ]; then echo "  [skipped in test] $1" | head -c 300; echo; return 0; fi
    "$VVC" run /bin/sh -c "$1"
}

echo "== sshd (drop-in, port $SSH_PORT, keys only)"
install -d -m 0755 "$CH/etc/ssh/sshd_config.d"
bak "$CH/etc/ssh/sshd_config.d/10-vaevictis.conf"
cat > "$CH/etc/ssh/sshd_config.d/10-vaevictis.conf" <<EOF
# VaeVictis hardened sshd (generated by vv-harden). First value wins, so this file overrides the stock config.
Port $SSH_PORT
HostKey /etc/ssh/ssh_host_ed25519_key
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey
PermitEmptyPasswords no
# Nobody can log in until an administrator adds a user to this group AND installs that user's public key.
AllowGroups sshusers
MaxAuthTries 3
MaxSessions 3
LoginGraceTime 20
ClientAliveInterval 300
ClientAliveCountMax 2
DisableForwarding yes
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
LogLevel VERBOSE
PrintMotd no
Banner none
MaxStartups 10:30:60
PerSourceMaxStartups 3
HostKeyAlgorithms ssh-ed25519
# Keys: ed25519 only (ssh-keygen -t ed25519), also on a security key (sk-). No RSA.
PubkeyAcceptedAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com
# Key exchange: post-quantum hybrids first, then X25519 for older clients
KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512,sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
# No file transfer server (sftp, and the scp of OpenSSH 9 and later, which uses it). The first "Subsystem sftp" read
# wins, and this file is read before /etc/ssh/sshd_config: its sftp line is not used. "scp -O" (the old protocol) runs
# a command over the login shell, like any user with a shell can.
Subsystem sftp /bin/false
EOF
chmod 0644 "$CH/etc/ssh/sshd_config.d/10-vaevictis.conf"

# systemd's ssh generator would open sshd on hidden vsock and unix sockets (and prints an error in VMs without vsock).
# We want exactly one way in: port $SSH_PORT. A symlink to /dev/null switches the generator off.
install -d -m 0755 "$CH/etc/systemd/system-generators"
ln -sf /dev/null "$CH/etc/systemd/system-generators/systemd-ssh-generator"

echo "== the SSH port is open in the firewall only while ssh.service runs"
install -d -m 0755 "$CH/etc/systemd/system/ssh.service.d" "$CH/etc/systemd/system/nftables.service.d"
bak "$CH/etc/systemd/system/ssh.service.d/10-vaevictis-firewall.conf"
cat > "$CH/etc/systemd/system/ssh.service.d/10-vaevictis-firewall.conf" <<EOF
# VaeVictis (generated by vv-harden): port $SSH_PORT is accepted by the firewall only while sshd runs.
# After nftables: loading the firewall empties the set, so the port is added once the firewall is there.
[Unit]
After=nftables.service

[Service]
ExecStartPre=-/usr/sbin/nft add element inet vv_filter ssh_open { $SSH_PORT }
ExecStopPost=-/usr/sbin/nft delete element inet vv_filter ssh_open { $SSH_PORT }
EOF
bak "$CH/etc/systemd/system/nftables.service.d/10-vaevictis-ssh.conf"
cat > "$CH/etc/systemd/system/nftables.service.d/10-vaevictis-ssh.conf" <<EOF
# VaeVictis (generated by vv-harden): loading the firewall empties the set ssh_open; put the SSH port back if sshd runs
# or is starting.
[Service]
ExecStartPost=-/bin/sh -c 'systemctl show -P ActiveState ssh.service | grep -qxE "active|activating|reloading" && /usr/sbin/nft add element inet vv_filter ssh_open { $SSH_PORT } || true'
ExecReload=-/bin/sh -c 'systemctl show -P ActiveState ssh.service | grep -qxE "active|activating|reloading" && /usr/sbin/nft add element inet vv_filter ssh_open { $SSH_PORT } || true'
EOF
chmod 0644 "$CH/etc/systemd/system/ssh.service.d/10-vaevictis-firewall.conf" "$CH/etc/systemd/system/nftables.service.d/10-vaevictis-ssh.conf"

echo "== host keys: created at boot if missing (Debian does not do it by itself)"
bak "$CH/etc/systemd/system/vv-ssh-hostkeys.service"
cat > "$CH/etc/systemd/system/vv-ssh-hostkeys.service" <<'EOF'
[Unit]
Description=Create the SSH host key on first boot
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key
Before=ssh.service
[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -q -t ed25519 -N "" -f /etc/ssh/ssh_host_ed25519_key
[Install]
WantedBy=multi-user.target
EOF

echo "== nftables firewall"
bak "$CH/etc/nftables.conf"
tmp="$(mktemp)"; nft_rules | cat -s > "$tmp"
if command -v nft >/dev/null 2>&1 && [ "$(id -u)" -eq 0 ]; then
    nft -c -f "$tmp" || { rm -f "$tmp"; die "generated firewall rules are invalid, nothing was changed for nftables"; }
    echo "  rules syntax checked with nft -c: OK"
else
    echo "  (nft not found, or not root: syntax not checked here; the package and the image builds check it)"
fi
install -m 0644 "$tmp" "$CH/etc/nftables.conf"; rm -f "$tmp"

echo "== fail2ban (sshd jail, nftables ban action)"
install -d -m 0755 "$CH/etc/fail2ban/jail.d"
bak "$CH/etc/fail2ban/jail.d/10-vaevictis.local"
cat > "$CH/etc/fail2ban/jail.d/10-vaevictis.local" <<EOF
# VaeVictis (generated by vv-harden)
[DEFAULT]
backend = systemd
banaction = nftables
banaction_allports = nftables[type=allports]
bantime = 1h
findtime = 10m
maxretry = 3

[sshd]
enabled = true
port = $SSH_PORT
mode = aggressive
journalmatch = _SYSTEMD_UNIT=ssh.service + _COMM=sshd
EOF

echo "== inside the chroot: group, services, checks"
in_chroot "
getent group sshusers >/dev/null || groupadd -r sshusers
systemctl unmask ssh.service
systemctl mask ssh.socket sshd-keygen.service
systemctl disable ssh.service
systemctl enable vv-ssh-hostkeys.service nftables.service fail2ban.service
echo '--- sshd -t (throwaway host key: the sealed image has none until first boot):'
k=/tmp/vv-sshd-test-key; rm -f \$k \$k.pub; ssh-keygen -q -t ed25519 -N '' -f \$k
/usr/sbin/sshd -t -h \$k && echo 'sshd config OK'
/usr/sbin/sshd -T -h \$k -C user=x,host=x,addr=127.0.0.1 | grep -E '^(subsystem|pubkeyacceptedalgorithms|kexalgorithms|maxstartups|persourcemaxstartups) '
rm -f \$k \$k.pub
echo '--- fail2ban-client -t:'; fail2ban-client -t 2>&1 | tail -2 || true
"

cat <<EOF

Done. Summary
  SSH       installed and hardened (port $SSH_PORT, ed25519 keys only, no root, group 'sshusers', no sftp) but SWITCHED OFF
  Firewall  in: nothing (port $SSH_PORT only while ssh runs, 4 new connections a minute per address) · out: everything · forward: libvirt only
  fail2ban  ssh jail: 3 failures in 10 min = 1 h ban
  Backups   $BK (only if something was replaced)
Turn it on later:  usermod -aG sshusers USER, put the key in ~USER/.ssh/authorized_keys, then  systemctl enable --now ssh
EOF
