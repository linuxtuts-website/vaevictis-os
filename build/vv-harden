#!/usr/bin/env bash
# vv-harden - hardened sshd + nftables firewall + fail2ban, written into the VaeVictis chroot
#
#   vv-harden           apply (safe to repeat; replaced files are backed up next to the chroot)
#   vv-harden rules     print the firewall rules that would be written
#
# Variables:  VV_CHROOT   chroot path
#             VV_SSH_PORT SSH port (default 2299)
set -euo pipefail

HERE="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
CH="${VV_CHROOT:-/run/media/user/Mio/Backup_VaeVictis_Completo/vaevictis/new/chroot}"
CH="$(realpath -m "$CH")"
SSH_PORT="${VV_SSH_PORT:-2299}"
VVC="$HERE/vv-chroot"

die() { echo "vv-harden: $*" >&2; exit 1; }
[[ "$SSH_PORT" =~ ^[0-9]+$ ]] && [ "$SSH_PORT" -ge 1024 ] && [ "$SSH_PORT" -le 65535 ] || die "VV_SSH_PORT must be 1024-65535"

V6_IN=""
if [ "${VV_IPV6:-0}" = 1 ]; then      # only for systems that keep IPv6 on (the live boot options switch it off)
    V6_IN='        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept'
fi

nft_rules() {
cat <<EOF
#!/usr/sbin/nft -f
# VaeVictis firewall (generated by vv-harden: edit the script variables, not this file)
#   in : drop everything except SSH (port $SSH_PORT), DHCP replies and the ICMP messages IPv4 needs
#   out: nothing is blocked (any port, any server; only invalid packets are dropped)
# Only our own table is replaced, so libvirt and fail2ban keep their rules.
# IPv6 is switched off at boot (ipv6.disable=1): no IPv6 rules. Systems that keep IPv6: run vv-harden with VV_IPV6=1.

add table inet vv_filter
delete table inet vv_filter

table inet vv_filter {
    chain input {
        type filter hook input priority filter; policy drop;
        iif "lo" accept
        ct state invalid drop
        ct state established,related accept
        icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
        udp sport 67 udp dport 68 accept
$V6_IN
        tcp dport $SSH_PORT ct state new accept
        iifname "virbr*" meta l4proto { tcp, udp } th dport 53 accept
        iifname "virbr*" udp dport 67 accept
        limit rate 3/minute log prefix "vv-drop-in " level info
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        iifname "virbr*" accept
    }

    chain output {
        type filter hook output priority filter; policy accept;
        ct state invalid drop
    }
}
EOF
}

[ "${1:-}" = "rules" ] && { nft_rules | cat -s; exit 0; }

[ "$(id -u)" -eq 0 ] || exec sudo -E VV_CHROOT="$CH" VV_SSH_PORT="$SSH_PORT" VV_IPV6="${VV_IPV6:-0}" "$0" "$@"
[ -f "$CH/etc/debian_version" ] && [ "$CH" != "/" ] || die "not a Debian root filesystem: $CH"
[ -x "$VVC" ] || [ -n "${VV_SKIP_CHROOT:-}" ] || die "vv-chroot must be next to this script ($VVC)"

BK="$(dirname "$CH")/vv-backups/$(date +%Y%m%d-%H%M%S)"
bak() {                                  # keep the previous version of a file, outside the image
    local rel="${1#$CH/}"
    [ -e "$1" ] || return 0
    mkdir -p "$BK"; (cd "$CH" && cp -a --parents "$rel" "$BK/")
}
in_chroot() {
    if [ -n "${VV_SKIP_CHROOT:-}" ]; then echo "  [skipped in test] $1" | head -c 300; echo; return 0; fi
    "$VVC" run /bin/sh -c "$1"
}

echo "== sshd (drop-in, port $SSH_PORT, keys only)"
install -d -m 0755 "$CH/etc/ssh/sshd_config.d"
bak "$CH/etc/ssh/sshd_config.d/10-vaevictis.conf"
cat > "$CH/etc/ssh/sshd_config.d/10-vaevictis.conf" <<EOF
# VaeVictis hardened sshd (generated by vv-harden). First value wins, so this file overrides the stock config.
Port $SSH_PORT
HostKey /etc/ssh/ssh_host_ed25519_key
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey
PermitEmptyPasswords no
# Nobody can log in until an administrator adds a user to this group AND installs that user's public key.
AllowGroups sshusers
MaxAuthTries 3
MaxSessions 3
LoginGraceTime 20
ClientAliveInterval 300
ClientAliveCountMax 2
DisableForwarding yes
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
LogLevel VERBOSE
PrintMotd no
Banner none
HostKeyAlgorithms ssh-ed25519
PubkeyAcceptedAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
EOF
chmod 0644 "$CH/etc/ssh/sshd_config.d/10-vaevictis.conf"

# systemd's ssh generator would open sshd on hidden vsock and unix sockets (and prints an error in VMs without vsock).
# We want exactly one way in: port $SSH_PORT. A symlink to /dev/null switches the generator off.
install -d -m 0755 "$CH/etc/systemd/system-generators"
ln -sf /dev/null "$CH/etc/systemd/system-generators/systemd-ssh-generator"

echo "== host keys: created at boot if missing (Debian does not do it by itself)"
bak "$CH/etc/systemd/system/vv-ssh-hostkeys.service"
cat > "$CH/etc/systemd/system/vv-ssh-hostkeys.service" <<'EOF'
[Unit]
Description=Create the SSH host key on first boot
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key
Before=ssh.service
[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -q -t ed25519 -N "" -f /etc/ssh/ssh_host_ed25519_key
[Install]
WantedBy=multi-user.target
EOF

echo "== nftables firewall"
bak "$CH/etc/nftables.conf"
tmp="$(mktemp)"; nft_rules | cat -s > "$tmp"
if command -v nft >/dev/null 2>&1; then
    nft -c -f "$tmp" || { rm -f "$tmp"; die "generated firewall rules are invalid, nothing was changed for nftables"; }
    echo "  rules syntax checked with nft -c: OK"
else
    echo "  (nft not found on this machine: syntax not checked, test in QEMU)"
fi
install -m 0644 "$tmp" "$CH/etc/nftables.conf"; rm -f "$tmp"

echo "== fail2ban (sshd jail, nftables ban action)"
install -d -m 0755 "$CH/etc/fail2ban/jail.d"
bak "$CH/etc/fail2ban/jail.d/10-vaevictis.local"
cat > "$CH/etc/fail2ban/jail.d/10-vaevictis.local" <<EOF
# VaeVictis (generated by vv-harden)
[DEFAULT]
backend = systemd
banaction = nftables
banaction_allports = nftables[type=allports]
bantime = 1h
findtime = 10m
maxretry = 3

[sshd]
enabled = true
port = $SSH_PORT
mode = aggressive
journalmatch = _SYSTEMD_UNIT=ssh.service + _COMM=sshd
EOF

echo "== inside the chroot: group, services, checks"
in_chroot "
getent group sshusers >/dev/null || groupadd -r sshusers
systemctl unmask ssh.service
systemctl mask ssh.socket sshd-keygen.service
systemctl disable ssh.service
systemctl enable vv-ssh-hostkeys.service nftables.service fail2ban.service
echo '--- sshd -t (throwaway host key: the sealed image has none until first boot):'
k=/tmp/vv-sshd-test-key; rm -f \$k \$k.pub; ssh-keygen -q -t ed25519 -N '' -f \$k
/usr/sbin/sshd -t -h \$k && echo 'sshd config OK'; rm -f \$k \$k.pub
echo '--- fail2ban-client -t:'; fail2ban-client -t 2>&1 | tail -2 || true
"

cat <<EOF

Done. Summary
  SSH       installed and hardened (port $SSH_PORT, keys only, no root, group 'sshusers') but SWITCHED OFF: nothing listens
  Firewall  in: SSH only · out: everything allowed · forward: libvirt only
  fail2ban  ssh jail: 3 failures in 10 min = 1 h ban
  Backups   $BK (only if something was replaced)
Turn it on later:  usermod -aG sshusers USER, put the key in ~USER/.ssh/authorized_keys, then  systemctl enable --now ssh
EOF
