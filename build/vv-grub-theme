#!/bin/sh
# vv-grub-theme - the VaeVictis boot menu (style A, minimal: black, the logo, the name, the chosen entry on violet)
# for an installed system. The theme itself is made by vv-boot-theme into /usr/share/vaevictis/grub-theme (logo,
# selection box, theme.txt, IBM Plex fonts converted for GRUB); this script copies it to /boot/grub/themes/vaevictis,
# where GRUB can read it before anything is unlocked, and points /etc/default/grub at it.
#
#   vv-grub-theme
#
# Variables: VV_ROOT=/path   work inside that root (the chroot or the installer's target) instead of /
#            VV_NO_UPDATE=1  do not run update-grub
# Safe to run again. If the theme cannot load, GRUB shows its plain text menu: nothing stops the computer from starting.
set -eu

ROOT="${VV_ROOT:-}"
SRC="$ROOT/usr/share/vaevictis/grub-theme"
THEME="$ROOT/boot/grub/themes/vaevictis"
DEFAULTS="$ROOT/etc/default/grub"

[ "$(id -u)" -eq 0 ] || { echo "vv-grub-theme: run it as root (sudo)" >&2; exit 1; }
[ -f "$SRC/theme.txt" ] || { echo "vv-grub-theme: $SRC/theme.txt not found (made by vv-boot-theme)" >&2; exit 1; }
[ -f "$DEFAULTS" ] || { echo "vv-grub-theme: $DEFAULTS not found" >&2; exit 1; }

# a fresh copy: files of an older theme (the 1.0 wallpaper) must not linger
rm -rf "$THEME"
install -d -m 0755 "$THEME"
for f in "$SRC"/*; do
    install -m 0644 "$f" "$THEME/"
done

# GRUB's own settings: a theme replaces GRUB_BACKGROUND; let GRUB pick the screen mode
sed -i -E '/^#?[[:space:]]*GRUB_BACKGROUND=/d' "$DEFAULTS"
setvar() {   # setvar NAME VALUE (replace the line if there is one, add it otherwise)
    if grep -qE "^#?[[:space:]]*$1=" "$DEFAULTS"; then
        sed -i -E "s|^#?[[:space:]]*$1=.*|$1=$2|" "$DEFAULTS"
    else
        printf '%s=%s\n' "$1" "$2" >> "$DEFAULTS"
    fi
}
setvar GRUB_THEME '"/boot/grub/themes/vaevictis/theme.txt"'
setvar GRUB_GFXMODE 'auto'

echo "theme written to ${THEME#"$ROOT"} ($(ls "$THEME" | wc -l) files)"
if [ -z "${VV_NO_UPDATE:-}" ] && [ -z "$ROOT" ]; then
    update-grub
else
    echo "update-grub not run (VV_ROOT or VV_NO_UPDATE is set): run it inside the system when ready"
fi
