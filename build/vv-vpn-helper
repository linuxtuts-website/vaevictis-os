#!/usr/bin/env python3
"""
vv-vpn-helper - privileged backend for VaeVictis VPN (always run through pkexec, which asks for the password).

  list                   rescan /etc/wireguard, refresh the public index, print the names
  up NAME [killswitch]   connect; with "killswitch", block every packet that does not go through the tunnel
  down NAME              disconnect (and switch the kill switch off: you asked to disconnect)
  ks-on NAME             switch the kill switch on for a tunnel that is already up
  ks-off                 switch the kill switch off
  import NAME            read a .conf from stdin and install it as /etc/wireguard/NAME.conf

Least privilege (1.1)
  - Configs are read with a whitelist: only the settings a WireGuard client needs are accepted, every value is
    checked. No PreUp/PostUp/PreDown/PostDown commands, no SaveConfig, nothing unknown. NAME is a plain
    interface name, never a path.
  - wg-quick never reads /etc/wireguard: it gets a clean copy in /run/vv-vpn/run (root only), rebuilt from the
    checked values, without DNS (set here with resolvconf) and with the server already as an IP address.
  - (1.3) Every value in that copy is written again in its standard form (addresses and networks as Python's ipaddress
    prints them, numbers as numbers), never copied from the file; IPv6 scope IDs ("%...") are refused; ListenPort is
    left out (a client does not need to listen on a port). Then a second, independent check reads the finished copy
    and the DNS lines: only the known settings and the characters of keys, addresses and numbers may appear, or nothing
    is started.
  - (1.3, after an AI-assisted review: Argon by Google, not an independent security audit) one server per config
    ([Peer]), with AllowedIPs; a full tunnel must name a DNS server this system can use (without one, DNS would keep
    going to the normal DNS server, outside the tunnel); no tunnel Address that is loopback, multicast, unspecified or
    link-local, or shorter than /8 (IPv4) or /32 (IPv6); the server's own address neither in the Address network nor
    in AllowedIPs other than /0 (the tunnel would carry its own packets); with a full tunnel, every DNS server must be
    reached through the tunnel once it is up (not, say, the router of the local network); no second tunnel that would take the
    kill switch off the first, or carry all traffic like it; "down" only for a VaeVictis tunnel or a WireGuard interface.
  - wg-quick runs in a systemd sandbox: of root's powers it keeps only CAP_NET_ADMIN (configure the network),
    the whole file system is read-only, /home, /root and the system's secrets are hidden, it cannot gain new
    privileges, load modules or open network connections of its own.

Kill switch (nftables table inet vv_killswitch)
  Output AND forwarded traffic (virtual machines) are dropped unless they go through the tunnel; DHCP and this
  PC's answers to its own virtual machines stay allowed. During a reconnect it stays on (only the new server is
  reachable), and if the connection fails it STAYS on, until you connect, disconnect, release it or restart.

IPv6: VaeVictis boots with ipv6.disable=1, so the kernel has no IPv6 at all. Then the IPv6 entries of Address,
DNS and AllowedIPs (that provider configs usually contain) are left out of the copy wg-quick reads; the config
in /etc/wireguard is not changed. Nothing can leak over IPv6 on a system that has none.
"""
import ipaddress
import json
import os
import re
import shutil
import socket
import subprocess
import sys

CONF_DIR = "/etc/wireguard"
STATE_DIR = "/var/lib/vv-vpn"
INDEX = os.path.join(STATE_DIR, "nodes")
WG_QUICK = "/usr/bin/wg-quick"
WG = "/usr/bin/wg"
NFT = "/usr/sbin/nft"
SYSTEMD_RUN = "/usr/bin/systemd-run"
MODPROBE = "/usr/sbin/modprobe"
IP = "/usr/bin/ip"
RUN_DIR = "/run/vv-vpn"                          # tmpfs: gone at reboot, like the nftables rules themselves
RT_DIR = os.path.join(RUN_DIR, "run")            # the clean configs wg-quick reads (root only)
EP_DIR = os.path.join(RUN_DIR, "endpoints")      # last server address of each tunnel, for a reconnect under the kill switch
KS_FLAG = os.path.join(RUN_DIR, "killswitch")    # exists while the kill switch is on; holds the interface name
NAME_RE = re.compile(r"[A-Za-z0-9_=+.-]{1,15}")  # used with fullmatch: no trailing newline can slip through
MAX_CONF = 64 * 1024

# wg-quick in a sandbox: root keeps only CAP_NET_ADMIN, everything else is read-only, hidden or forbidden
SANDBOX = [
    "CapabilityBoundingSet=CAP_NET_ADMIN",
    "NoNewPrivileges=yes",
    "ProtectSystem=strict",
    "ProtectHome=yes",
    "PrivateTmp=yes",
    "PrivateDevices=yes",
    "ProtectKernelModules=yes",
    "ProtectKernelLogs=yes",
    "ProtectControlGroups=yes",
    "ProtectClock=yes",
    "ProtectHostname=yes",
    "ProtectProc=invisible",
    "InaccessiblePaths=-/etc/wireguard -/etc/shadow -/etc/gshadow -/etc/sudoers -/etc/sudoers.d -/etc/ssh "
    "-/etc/cryptsetup-keys.d -/etc/NetworkManager/system-connections -/root -/boot -/var/lib/vv-vpn",
    "RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6",
    "IPAddressDeny=any",
    "RestrictNamespaces=yes",
    "RestrictRealtime=yes",
    "RestrictSUIDSGID=yes",
    "LockPersonality=yes",
    "MemoryDenyWriteExecute=yes",
    "SystemCallArchitectures=native",
    "SystemCallFilter=@system-service",
    "SystemCallErrorNumber=EPERM",
    "UMask=0077",
]

KEY_RE = re.compile(r"[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=")
HOST_RE = re.compile(r"(?=.{1,253}$)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
                     r"(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\.?")
ALLOWED = {
    "interface": ("privatekey", "address", "dns", "mtu", "listenport", "table"),
    "peer": ("publickey", "presharedkey", "allowedips", "endpoint", "persistentkeepalive"),
}
CANON = {"privatekey": "PrivateKey", "address": "Address", "dns": "DNS", "mtu": "MTU", "listenport": "ListenPort",
         "table": "Table", "fwmark": "FwMark", "publickey": "PublicKey", "presharedkey": "PresharedKey",
         "allowedips": "AllowedIPs", "endpoint": "Endpoint", "persistentkeepalive": "PersistentKeepalive"}
HOOKS = ("preup", "postup", "predown", "postdown")
# the second check (1.3): what the finished copy for wg-quick and the DNS lines may contain, whatever the parser let through
SAFE_LINE = re.compile(r"\[(?:Interface|Peer)\]|(?:PrivateKey|PublicKey|PresharedKey|Address|AllowedIPs|Endpoint|MTU"
                       r"|PersistentKeepalive|Table) = [A-Za-z0-9+/=.:,\[\] ]{1,65536}|")      # 65536: MAX_CONF, the whole file
SAFE_IP = re.compile(r"[0-9A-Fa-f.:]{2,45}")


class ConfError(Exception):
    pass


def fail(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def valid_name(name):
    return bool(NAME_RE.fullmatch(name or ""))


def check_name(name):
    if not valid_name(name):
        fail("Invalid node name (allowed: letters, digits and _ = + . - , max 15 chars).")
    return name


def nodes():
    try:
        names = [f[:-5] for f in os.listdir(CONF_DIR) if f.endswith(".conf")]
    except FileNotFoundError:
        names = []
    return sorted(n for n in names if valid_name(n))


def write_index():
    """World-readable list of names only (the configs themselves hold private keys)."""
    os.makedirs(STATE_DIR, exist_ok=True)
    os.chmod(STATE_DIR, 0o755)
    tmp = INDEX + ".tmp"
    with open(tmp, "w") as fh:
        fh.write("".join(n + "\n" for n in nodes()))
    os.chmod(tmp, 0o644)
    os.replace(tmp, INDEX)


def ipv6_available():
    return os.path.isdir("/proc/sys/net/ipv6")


# ---- config: whitelist parser ----------------------------------------------------------------------------
def _items(value):
    return [x.strip() for x in value.split(",") if x.strip()]


def split_endpoint(value):
    """'host:port', '1.2.3.4:port' or '[v6]:port' -> (host, port)."""
    m = re.fullmatch(r"\[([0-9A-Fa-f:.]+)\]:(\d{1,5})", value) or re.fullmatch(r"([^:\s\[\]]+):(\d{1,5})", value)
    if not m or not 0 < int(m.group(2)) < 65536:
        raise ConfError(f"invalid Endpoint '{value}' (expected host:port)")
    host = m.group(1)
    try:
        ipaddress.ip_address(host)
    except ValueError:
        if not HOST_RE.fullmatch(host):
            raise ConfError(f"invalid server name in Endpoint '{value}'")
    return host, int(m.group(2))


def _int_in(value, lo, hi, key):
    if not re.fullmatch(r"\d{1,10}", value) or not lo <= int(value) <= hi:
        raise ConfError(f"invalid {CANON[key]} '{value}'")


def check_value(key, value):
    if "%" in value and key in ("address", "allowedips", "dns"):
        raise ConfError(f"invalid {CANON[key]} '{value}' (IPv6 scope IDs are not supported)")
    try:
        if key in ("privatekey", "publickey", "presharedkey"):
            if not KEY_RE.fullmatch(value):
                raise ConfError(f"invalid {CANON[key]} (not a WireGuard key)")
        elif key == "address":
            for x in _items(value) or [""]:
                ifc = ipaddress.ip_interface(x)
                ip = ifc.ip
                if ip.is_loopback or ip.is_multicast or ip.is_unspecified or ip.is_link_local:
                    raise ConfError(f"invalid Address '{x}' (not an address a tunnel can use)")
                if ifc.network.prefixlen < (8 if ifc.version == 4 else 32):
                    raise ConfError(f"invalid Address '{x}' (a network this large would take over the routing of the "
                                    "whole computer)")
        elif key == "allowedips":
            for x in _items(value) or [""]:
                ipaddress.ip_network(x, strict=False)
        elif key == "dns":
            for x in _items(value) or [""]:
                try:
                    ipaddress.ip_address(x)
                except ValueError:
                    if not HOST_RE.fullmatch(x):
                        raise ConfError(f"invalid DNS entry '{x}'")
        elif key == "endpoint":
            split_endpoint(value)
        elif key == "mtu":
            _int_in(value, 576, 65535, key)
        elif key == "listenport":
            _int_in(value, 0, 65535, key)
        elif key == "persistentkeepalive":
            if value.lower() != "off":
                _int_in(value, 0, 65535, key)
        elif key == "table":
            # only the default: with "off" or another table wg-quick adds no route, and the traffic would keep
            # leaving outside the tunnel while the tunnel shows as connected
            if value.lower() != "auto":
                raise ConfError(f"Table = {value} is not supported (custom routing: the traffic might not go through "
                                "the tunnel)")
    except ValueError:
        raise ConfError(f"invalid {CANON[key]} '{value}'")


def parse_conf(text):
    """[('interface', [(key, value), ...]), ('peer', [...]), ...]: only known settings, every value checked."""
    sections = []
    for n, raw in enumerate(text.lstrip("\ufeff").splitlines(), 1):    # a BOM, as some Windows editors write
        line = raw.split("#", 1)[0].strip()          # like wg-quick: '#' starts a comment anywhere
        if not line:
            continue
        m = re.fullmatch(r"\[\s*([A-Za-z]+)\s*\]", line)
        if m:
            sec = m.group(1).lower()
            if sec not in ALLOWED:
                raise ConfError(f"line {n}: unknown section [{m.group(1)}]")
            if sec == "interface" and any(s == "interface" for s, _ in sections):
                raise ConfError(f"line {n}: a second [Interface] section")
            sections.append((sec, []))
            continue
        if "=" not in line:
            raise ConfError(f"line {n}: not a 'Setting = value' line")
        key, value = (x.strip() for x in line.split("=", 1))
        key = key.lower()
        if key in HOOKS:
            raise ConfError("the config contains PreUp/PostUp/PreDown/PostDown commands, which would run as root")
        if key == "saveconfig":
            raise ConfError("SaveConfig is not supported (it would rewrite the config)")
        if key == "fwmark":
            raise ConfError("FwMark is not supported (custom routing: the traffic might not go through the tunnel)")
        if not sections:
            raise ConfError(f"line {n}: a setting before [Interface]")
        sec = sections[-1][0]
        if key not in ALLOWED[sec]:
            raise ConfError(f"line {n}: '{key}' is not a setting VaeVictis VPN accepts in [{sec.capitalize()}]")
        if any(k == key for k, _ in sections[-1][1]) and key not in ("address", "dns", "allowedips"):
            raise ConfError(f"line {n}: {CANON[key]} appears twice in the same section")
        check_value(key, value)
        sections[-1][1].append((key, value))
    if not sections or sections[0][0] != "interface":
        raise ConfError("no [Interface] section at the top")
    if not any(k == "privatekey" for k, _ in sections[0][1]):
        raise ConfError("[Interface] has no PrivateKey")
    peers = [items for sec, items in sections if sec == "peer"]
    if not peers:
        raise ConfError("no [Peer] section")
    if len(peers) > 1:
        raise ConfError(f"{len(peers)} [Peer] sections: VaeVictis VPN runs client configs with one server (one [Peer])")
    for items in peers:
        if not any(k == "publickey" for k, _ in items):
            raise ConfError("a [Peer] has no PublicKey")
        if not any(k == "endpoint" for k, _ in items):
            raise ConfError("a [Peer] has no Endpoint (the address of its server): VaeVictis VPN runs client configs only")
        if not any(k == "allowedips" for k, _ in items):
            raise ConfError("the [Peer] has no AllowedIPs (which traffic goes through the tunnel)")
    return sections


def read_conf(name):
    path = os.path.join(CONF_DIR, name + ".conf")
    if not os.path.isfile(path):
        fail(f"No config named '{name}' in {CONF_DIR}.")
    with open(path, encoding="utf-8", errors="replace") as fh:
        text = fh.read(MAX_CONF + 1)
    if len(text) > MAX_CONF:
        fail("Config file is too large.")
    try:
        return parse_conf(text)
    except ConfError as e:
        fail(f"{name}.conf is not accepted: {e}.\nVaeVictis VPN runs only plain client configs. If you trust this "
             f"one, start it from a terminal with: sudo wg-quick up {name}")


def first(items, key):
    for k, v in items:
        if k == key:
            return v
    return None


def full_tunnel(sections):
    """True when some peer sends all IPv4 traffic through the tunnel."""
    for sec, items in sections:
        if sec == "peer":
            for k, v in items:
                if k == "allowedips" and any(ipaddress.ip_network(x, strict=False) == ipaddress.ip_network("0.0.0.0/0")
                                             for x in _items(v)):
                    return True
    return False


def load_cache(name):
    path = os.path.join(EP_DIR, name + ".json")
    try:
        with open(path) as fh:
            raw = json.load(fh)
        return {pub: (str(ipaddress.ip_address(ip)), int(port)) for pub, (ip, port) in raw.items()
                if KEY_RE.fullmatch(pub) and 0 < int(port) < 65536}
    except FileNotFoundError:
        return {}
    except (OSError, ValueError, TypeError, AttributeError):
        print(f"The saved server address of '{name}' is unreadable ({path}): it is not used.", file=sys.stderr)
        return {}


def resolve_endpoints(sections, allow_dns, cached, ipv6):
    """{peer public key: (ip, port)}. Host names are looked up now, while the network may still answer: under the
    kill switch only the last known address of the same server can be used (nothing may leave outside the tunnel)."""
    out = {}
    for sec, items in sections:
        ep = first(items, "endpoint") if sec == "peer" else None
        if not ep:
            continue
        pub = first(items, "publickey")
        host, port = split_endpoint(ep)
        try:
            ip = ipaddress.ip_address(host)
        except ValueError:
            if not allow_dns:
                if pub in cached:
                    out[pub] = cached[pub]
                    continue
                raise ConfError(f"the server is given by name ({host}), which cannot be looked up while the kill switch "
                                "blocks the network. Release the kill switch to connect, or use a config with the "
                                "server's IP address")
            try:
                infos = socket.getaddrinfo(host, port, socket.AF_UNSPEC if ipv6 else socket.AF_INET, socket.SOCK_DGRAM)
            except OSError as e:
                raise ConfError(f"cannot find the address of the server {host}: {e}")
            ip = ipaddress.ip_address(infos[0][4][0])
        if ip.version == 6 and not ipv6:
            raise ConfError(f"the server {host} has an IPv6 address, and IPv6 is off on this system")
        out[pub] = (str(ip), port)
    return out


def canonical(key, value):
    """The value as it goes into the copy: written again from what was parsed, never the text of the file."""
    if key in ("privatekey", "publickey", "presharedkey"):
        return value                                  # already a full match of KEY_RE: 44 base64 characters
    if key == "address":
        return [ipaddress.ip_interface(x) for x in _items(value)]
    if key == "allowedips":
        return [ipaddress.ip_network(x, strict=False) for x in _items(value)]
    if key in ("mtu", "persistentkeepalive"):
        return "off" if value.lower() == "off" else str(int(value))
    if key == "table":
        return "auto"                                 # the only value check_value accepts
    raise ConfError(f"{CANON[key]} has no place in the copy for wg-quick")


def second_check(text, dns, search):
    """Independent of the parser: the finished copy may hold only known settings with the characters of keys, addresses
    and numbers, the DNS lines only addresses and host names. Anything else means a bug above: nothing is started."""
    for n, line in enumerate(text.split("\n"), 1):
        if not SAFE_LINE.fullmatch(line):
            raise ConfError(f"internal check failed on line {n} of the copy for wg-quick; nothing was started")
    if not all(SAFE_IP.fullmatch(d) for d in dns) or not all(HOST_RE.fullmatch(s) for s in search):
        raise ConfError("internal check failed on the DNS settings; nothing was started")


def runtime_conf(sections, endpoints, ipv6):
    """The text wg-quick reads, rebuilt only from checked values; plus the DNS servers and search domains."""
    lines, dns, search, v4_addr, allowed, nets, routed = [], [], [], False, False, [], []
    for sec, items in sections:
        lines.append("[Interface]" if sec == "interface" else "[Peer]")
        pub = first(items, "publickey")
        for key, value in items:
            if key == "dns":
                for x in _items(value):
                    try:
                        ip = ipaddress.ip_address(x)
                        if ip.version == 4 or ipv6:
                            dns.append(str(ip))
                    except ValueError:
                        search.append(x)
                continue
            if key == "listenport":
                continue                              # a client does not need to listen on a port
            if key == "endpoint":
                ip, port = endpoints[pub]
                value = f"[{ip}]:{port}" if ":" in ip else f"{ip}:{port}"
            else:
                value = canonical(key, value)
            if key in ("address", "allowedips"):
                vals = [x for x in value if x.version == 4 or ipv6]
                if not vals:
                    continue
                if key == "address":
                    v4_addr = v4_addr or any(x.version == 4 for x in vals)
                    nets += [x.network for x in vals]
                else:
                    allowed = True
                    # wg-quick routes /0 with its own rules; any other network goes into the main routing table
                    routed += [x for x in vals if x.prefixlen > 0]
                value = ", ".join(str(x) for x in vals)
            lines.append(f"{CANON[key]} = {value}")
        lines.append("")
    if not v4_addr and not ipv6:
        raise ConfError("the config has only IPv6 addresses, and IPv6 is off on this system")
    if not allowed:
        raise ConfError("no AllowedIPs this system can use (only IPv6 ones, and IPv6 is off): no traffic would go "
                        "through the tunnel")
    if full_tunnel(sections) and not dns:
        raise ConfError("the config has no DNS server this system can use (DNS = ...): DNS queries would keep going to "
                        "your normal DNS server, outside the tunnel. Use the config file your provider gives, with its "
                        "DNS line")
    for ip, _port in endpoints.values():
        if any(ipaddress.ip_address(ip) in n for n in nets):
            raise ConfError(f"the server's address {ip} is inside the tunnel's own Address: the tunnel would send "
                            "its own packets into itself")
        inside = [n for n in routed if ipaddress.ip_address(ip) in n]
        if inside:
            raise ConfError(f"the server's address {ip} is inside AllowedIPs {inside[0]}: the tunnel would send "
                            "its own packets into itself (wg-quick adds no separate route for the server). "
                            "For all traffic use AllowedIPs = 0.0.0.0/0")
    text = "\n".join(lines)
    second_check(text, dns, search)
    return text, dns, search


# ---- running wg-quick in the sandbox ---------------------------------------------------------------------------
def write_private(path, text):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)


def private_dir(path):
    os.makedirs(path, mode=0o700, exist_ok=True)
    os.chmod(path, 0o700)


def sandboxed_wg_quick(action, conf_path):
    cmd = [SYSTEMD_RUN, "--quiet", "--wait", "--pipe", "--collect", "--service-type=exec",
           "--description=VaeVictis VPN: wg-quick in a sandbox", "--setenv=PATH=/usr/sbin:/usr/bin"]
    for prop in SANDBOX:
        cmd += ["-p", prop]
    cmd += ["--", WG_QUICK, action, conf_path]
    return subprocess.run(cmd, stdin=subprocess.DEVNULL).returncode


def set_dns(name, dns, search):
    if not dns:
        return True
    rc = shutil.which("resolvconf", path="/usr/sbin:/sbin:/usr/bin")
    if not rc:
        print("resolvconf is missing (package openresolv): the DNS servers of the VPN cannot be set.", file=sys.stderr)
        return False
    data = "".join(f"nameserver {d}\n" for d in dns) + (f"search {' '.join(search)}\n" if search else "")
    return subprocess.run([rc, "-a", name, "-m", "0", "-x"], input=data, text=True).returncode == 0


def unset_dns(name):
    rc = shutil.which("resolvconf", path="/usr/sbin:/sbin:/usr/bin")
    if rc:
        subprocess.run([rc, "-d", name, "-f"], capture_output=True)


def live_endpoints(name):
    """{public key: (ip, port)} of the servers the running tunnel talks to, as WireGuard has them."""
    r = subprocess.run([WG, "show", name, "endpoints"], capture_output=True, text=True)
    if r.returncode != 0:
        fail(f"'{name}' is not an active tunnel.")
    found = {}
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) != 2 or ":" not in parts[1]:
            continue
        host, port = parts[1].rsplit(":", 1)
        try:
            found[parts[0]] = (str(ipaddress.ip_address(host.strip("[]"))), int(port))
        except ValueError:
            continue
    return found


def save_cache(name, endpoints):
    os.makedirs(RUN_DIR, mode=0o755, exist_ok=True)
    private_dir(EP_DIR)
    write_private(os.path.join(EP_DIR, name + ".json"), json.dumps(endpoints))


# ---- kill switch -----------------------------------------------------------------------------------------------
def ks_rules(iface, endpoints):
    out = ['oif "lo" accept',
           f'oifname "{iface}" accept']
    for ip, port in sorted(set(endpoints)):
        out.append(f"{'ip6' if ':' in ip else 'ip'} daddr {ip} udp dport {port} accept")
    out += ["udp sport 68 udp dport 67 accept",          # DHCP, so the network itself keeps working
            "udp sport 546 udp dport 547 accept",
            'oifname "virbr*" accept']                    # this PC's answers to its own virtual machines (DHCP, DNS)
    fwd = [f'oifname "{iface}" accept',                   # virtual machines -> the tunnel
           f'iifname "{iface}" ct state established,related accept',
           'iifname "virbr*" oifname "virbr*" accept']    # between virtual machines
    j = "\n        ".join
    return (f"add table inet vv_killswitch\n"
            f"delete table inet vv_killswitch\n"
            f"table inet vv_killswitch {{\n"
            f"    chain output {{\n"
            f"        type filter hook output priority -150; policy drop;\n"
            f"        {j(out)}\n"
            f"    }}\n"
            f"    chain forward {{\n"
            f"        type filter hook forward priority -150; policy drop;\n"
            f"        {j(fwd)}\n"
            f"    }}\n"
            f"}}\n")


def ks_install(iface, endpoints):
    """Replace the kill switch rules in one step (no moment without them). False if nftables refused."""
    r = subprocess.run([NFT, "-f", "-"], input=ks_rules(iface, endpoints), capture_output=True, text=True)
    if r.returncode != 0:
        print("nftables refused the kill switch rules:\n" + r.stderr.strip(), file=sys.stderr)
        return False
    os.makedirs(RUN_DIR, mode=0o755, exist_ok=True)
    write_private(KS_FLAG, iface + "\n")             # root only; the window just checks that it exists
    os.chmod(KS_FLAG, 0o600)                          # also when an older version made it readable by all
    return True


def ks_iface():
    """The tunnel the kill switch is guarding, or None when it is off."""
    try:
        with open(KS_FLAG) as fh:
            return fh.read().strip() or None
    except OSError:
        return None


def ks_off():
    subprocess.run([NFT, "delete", "table", "inet", "vv_killswitch"], capture_output=True)
    try:
        os.remove(KS_FLAG)
    except FileNotFoundError:
        pass


def ks_on(name):
    if not full_tunnel(read_conf(name)):
        fail("The kill switch needs a full-tunnel config (AllowedIPs = 0.0.0.0/0): "
             "with this config part of your traffic is meant to leave outside the tunnel.")
    endpoints = list(live_endpoints(name).values())
    if not endpoints:
        fail("Cannot find the server address of this tunnel: kill switch NOT activated.")
    if not ks_install(name, endpoints):
        fail("Kill switch NOT activated.")


# ---- commands --------------------------------------------------------------------------------------------------
def wg_interfaces():
    """The WireGuard interfaces that are up now (whatever started them)."""
    try:
        r = subprocess.run([WG, "show", "interfaces"], capture_output=True, text=True)
    except OSError:
        return []
    return r.stdout.split() if r.returncode == 0 else []


def wg_full(iface):
    """True when a WireGuard interface that is up sends all traffic of an address family through itself."""
    try:
        r = subprocess.run([WG, "show", iface, "allowed-ips"], capture_output=True, text=True)
    except OSError:
        return False
    return r.returncode == 0 and any(x in ("0.0.0.0/0", "::/0") for x in r.stdout.split())


def dns_outside(name, dns):
    """The DNS servers that the routing does NOT send through the tunnel NAME (asked once the tunnel is up), for
    example the router of the local network: with a full tunnel its own network stays outside the tunnel."""
    out = []
    for d in dns:
        try:
            r = subprocess.run([IP, "-j", "route", "get", d], capture_output=True, text=True)
            routes = json.loads(r.stdout) if r.returncode == 0 else []
        except (OSError, ValueError):
            routes = []
        if not isinstance(routes, list) or not routes or not isinstance(routes[0], dict) or routes[0].get("dev") != name:
            out.append(d)
    return out


def abort_up(name, conf, guard, msg):
    """The tunnel is up but must not be used: take it down again, nothing left behind (the kill switch stays)."""
    sandboxed_wg_quick("down", conf)
    try:
        os.remove(conf)
    except FileNotFoundError:
        pass
    fail(msg + ("\nThe kill switch stays on: nothing leaves this PC." if guard else ""))


def cmd_up(name, want_ks):
    if name in wg_interfaces():
        fail(f"'{name}' is already connected.")
    sections = read_conf(name)
    # Another tunnel: the kill switch would be moved off it (its traffic blocked), and two tunnels that both carry all
    # traffic send each other's packets into themselves. A tunnel for a few networks next to the VPN is fine.
    others = [i for i in wg_interfaces() if i != name]
    if ks_iface() in others:
        fail(f"The kill switch guards the tunnel '{ks_iface()}', which is up: disconnect it first.")
    if full_tunnel(sections) and any(wg_full(i) for i in others):
        fail(f"Another tunnel that carries all traffic is up ({', '.join(i for i in others if wg_full(i))}): "
             "disconnect it first. Two of them cannot work at the same time.")
    ipv6 = ipv6_available()
    blocked = os.path.exists(KS_FLAG)                 # the kill switch is on now (for example a dropped tunnel)
    guard = want_ks or blocked                        # keep everything blocked while connecting
    if want_ks and not full_tunnel(sections):
        fail("The kill switch needs a full-tunnel config (AllowedIPs = 0.0.0.0/0). "
             "Connect without the kill switch, or use another config.")
    try:
        endpoints = resolve_endpoints(sections, allow_dns=not blocked, cached=load_cache(name), ipv6=ipv6)
        text, dns, search = runtime_conf(sections, endpoints, ipv6)
    except ConfError as e:
        fail(f"Not connected: {e}." + ("\nThe kill switch stays on: nothing leaves this PC." if blocked else ""))
    if not ipv6 and any(":" in x for sec, items in sections for k, v in items
                        if k in ("address", "allowedips", "dns") for x in _items(v)):
        print("IPv6 is off on this system: the IPv6 entries of the config are not used.", file=sys.stderr)
    if guard and not ks_install(name, list(endpoints.values())):
        fail("Not connected: the kill switch could not be set." +
             ("\nThe previous kill switch stays on: nothing leaves this PC." if blocked else ""))
    save_cache(name, endpoints)                       # so that "connect again" works under the kill switch, also if
                                                      # this first attempt fails

    os.makedirs(RUN_DIR, mode=0o755, exist_ok=True)
    private_dir(RT_DIR)
    conf = os.path.join(RT_DIR, name + ".conf")
    write_private(conf, text)
    subprocess.run([MODPROBE, "-q", "wireguard"], capture_output=True)    # here, not in the sandbox (no modules there)
    rc = sandboxed_wg_quick("up", conf)
    if rc != 0:
        try:
            os.remove(conf)
        except FileNotFoundError:
            pass
        if guard:
            print("Not connected. The kill switch stays on: nothing leaves this PC. Connect again, "
                  "or release the kill switch to use your normal connection.", file=sys.stderr)
        sys.exit(rc)
    outside = dns_outside(name, dns) if full_tunnel(sections) else []
    if outside:
        abort_up(name, conf, guard, f"Not connected: the DNS server {', '.join(outside)} of this config is not reached "
                 "through the tunnel (an address of your own network?): DNS would leave outside it.")
    if not set_dns(name, dns, search):
        abort_up(name, conf, guard, "Not connected: the DNS servers of the VPN could not be set "
                 "(DNS would leave outside the tunnel).")
    live = live_endpoints(name)
    save_cache(name, live)
    if want_ks:
        if not ks_install(name, list(live.values()) or list(endpoints.values())):
            fail("The tunnel is up but the kill switch could not be set: your traffic is NOT protected if it drops.")
    elif blocked:
        ks_off()                                      # connected without asking for it: back to the plain tunnel


def cmd_down(name):
    if name not in nodes() and name not in wg_interfaces():
        fail(f"'{name}' is not a VaeVictis VPN tunnel: nothing done.")
    conf = os.path.join(RT_DIR, name + ".conf")
    if not os.path.isfile(conf):                      # brought up some other way: wg-quick only needs the name
        os.makedirs(RUN_DIR, mode=0o755, exist_ok=True)
        private_dir(RT_DIR)
        write_private(conf, "[Interface]\n")
    rc = sandboxed_wg_quick("down", conf)
    unset_dns(name)
    if ks_iface() in (None, name):                    # the user chose to disconnect: back to the normal network
        ks_off()                                      # (never the kill switch of another tunnel)
    for path in (conf, os.path.join(EP_DIR, name + ".json")):
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
    sys.exit(rc)


def cmd_import(name):
    data = sys.stdin.buffer.read(MAX_CONF + 1)
    if len(data) > MAX_CONF:
        fail("Config file is too large.")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        fail("Config file is not valid UTF-8 text.")
    try:
        parse_conf(text)
    except ConfError as e:
        fail(f"Refused: {e}.\nVaeVictis VPN imports only plain WireGuard client configs. If you really need "
             "this one, review it and copy it to /etc/wireguard yourself, then start it with sudo wg-quick.")
    os.makedirs(CONF_DIR, mode=0o700, exist_ok=True)
    dest = os.path.join(CONF_DIR, name + ".conf")
    try:
        fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        fail(f"A config named '{name}' already exists.")
    with os.fdopen(fd, "wb") as fh:
        fh.write(data)
    write_index()
    print(f"Imported {name}")


USAGE = "usage: vv-vpn-helper list | up NAME [killswitch] | down NAME | ks-on NAME | ks-off | import NAME"


def main():
    if os.geteuid() != 0:
        fail("This helper must run as root (use pkexec).", 2)
    os.umask(0o022)
    args = sys.argv[1:]
    if not args:
        fail(USAGE, 2)
    cmd = args[0]
    if cmd == "list" and len(args) == 1:
        write_index()
        print("\n".join(nodes()))
    elif cmd == "up" and len(args) in (2, 3):
        if len(args) == 3 and args[2] != "killswitch":
            fail(USAGE, 2)
        name = check_name(args[1])
        write_index()
        cmd_up(name, len(args) == 3)
    elif cmd == "down" and len(args) == 2:
        cmd_down(check_name(args[1]))
    elif cmd == "ks-on" and len(args) == 2:
        ks_on(check_name(args[1]))
    elif cmd == "ks-off" and len(args) == 1:
        ks_off()
    elif cmd == "import" and len(args) == 2:
        cmd_import(check_name(args[1]))
    else:
        fail(USAGE, 2)


if __name__ == "__main__":
    main()
