            f"that IPv4 needs to work, and SSH (port {port}) if you switch it on. Outgoing traffic is not blocked, so every program can reach any port or server. "
            "Dropped incoming packets are logged, at most 3 lines a minute.", "dim", wrap=True), False, False, 0)
        box.pack_start(lab("sudo nft list ruleset\nsudo journalctl -k | grep vv-drop", "code", selectable=True), False, False, 0)
        box.pack_start(lab("SSH", "h"), False, False, 6)
        box.pack_start(lab(
            f"Switched off by default: nothing listens on the network. When you want it, it is hardened already: port {port}, "
            "public-key login only (no passwords, no root), only members of the group 'sshusers'. Authorize yourself, then start it:", "dim", wrap=True), False, False, 0)
        box.pack_start(lab("sudo usermod -aG sshusers $USER\nmkdir -p ~/.ssh && nano ~/.ssh/authorized_keys\nsudo systemctl enable --now ssh        # and to turn it off again: sudo systemctl disable --now ssh", "code", selectable=True), False, False, 0)
        box.pack_start(lab("FAIL2BAN", "h"), False, False, 6)
        box.pack_start(lab(
            "Watches the SSH log. Three failed logins within 10 minutes ban the address for one hour, using an nftables set.", "dim", wrap=True), False, False, 0)
        box.pack_start(lab("sudo fail2ban-client status sshd", "code", selectable=True), False, False, 0)
        box.pack_start(lab("VPN", "h"), False, False, 6)
        box.pack_start(lab(
            "WireGuard on the allowed UDP port (51820 by default). The VPN does not block traffic that stays outside the tunnel: "
            "there is no kill switch yet.", "dim", wrap=True), False, False, 0)
        return sw

    def _apps_page(self):
        sw, box = page()
        for name, text in (
            ("VPN", "WireGuard manager. IMPORT your provider's .conf file, then CONNECT. Privileged actions go through a small "
                    "checked helper (polkit), never through the app itself."),
            ("Aurora", "Offline, privacy-focused audio player. No network access."),
            ("Linpaint", "Dark MS-Paint-style editor: pencil, brush, spray, eraser, fill, picker, text and shapes. "
                         "Takes screenshots (full screen or area, with a delay) and opens them for editing."),
            ("PDF Tool", "View and edit PDFs locally (Ctrl+T to insert text). Nothing is uploaded anywhere."),
            ("Snap", "Incremental snapshots with hardlinks (rsync) for ext4, xfs and btrfs: system snapshot (without /home), "
                     "folder backup, list, delete and restore. Run 'sudo v-snap'. Installed systems only. "
                     "It lives on the same disk: it protects from a bad update, not from a dead disk."),
            ("HIDS", "File integrity dashboard: the last 100 log lines, refreshed every 3 seconds. A change you made yourself "
                     "(for example a new password) shows up as an alert; 'Authorize Changes & Seal System' accepts the "
                     "current state as the new reference. Use it ONLY for your own changes, sealing an intrusion would hide it."),
            ("Panic", "Cuts the network, flushes the disks and powers off at once (needs no password, asks nothing twice). "
                      "It is not a secure erase: RAM fades after power-off, it is not wiped."),
            ("KeePassXC", "Offline password manager. Your database is a single encrypted file; nothing is synced anywhere."),
            ("mat2", "Strips metadata (author, GPS, camera, software) from files. Terminal: mat2 photo.jpg"),
            ("Lynis", "Security auditor: sudo lynis audit system. It scores this system and lists what could be tighter."),
            ("debsums", "Checks installed files against their package checksums: sudo debsums -c lists the files that changed."),
            ("VM tools", "spice-vdagent and qemu-guest-agent give clipboard and screen resizing inside a virtual machine. "
                         "They do nothing on real hardware."),
        ):
            box.pack_start(lab(name, "name"), False, False, 0)
            box.pack_start(lab(text, "dim", wrap=True), False, False, 4)
        return sw

    def on_close(self, _btn):
        self.destroy()


if __name__ == "__main__":
    if "--force" not in sys.argv:
        if os.path.exists(FLAG):
            sys.exit(0)
        try:                                   # first start: remember it now, so it never opens by itself again
            os.makedirs(os.path.dirname(FLAG), exist_ok=True)
            open(FLAG, "w").close()
        except OSError:
            pass
    GLib.set_prgname("vv-welcome")            # must match vv-welcome.desktop: gives the window its icon
    GLib.set_application_name("VaeVictis Welcome")
    Gtk.Window.set_default_icon_name("vv-welcome")
    win = Welcome()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
