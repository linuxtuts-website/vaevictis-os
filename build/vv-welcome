# ---------------------------------------------------------------- reading the running system
def rd(path, default=None):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return default


def sysctl(key):
    return rd("/proc/sys/" + key.replace(".", "/"))


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def ssh_port():
    m = re.search(r"^\s*Port\s+(\d+)", rd(SSHD_DROPIN, "") or "", re.M)
    return m.group(1) if m else "?"


def gdm_autologin():
    """Active automatic or timed login settings of GDM (a line starting with # does not count)."""
    on = set()
    for f in ("/etc/gdm3/daemon.conf", "/etc/gdm3/custom.conf"):
        for ln in (rd(f, "") or "").splitlines():
            m = re.match(r"^\s*(AutomaticLoginEnable|TimedLoginEnable)\s*=\s*(true|1|yes)\s*$", ln, re.I)
            if m:
                on.add(m.group(1))
    return sorted(on)


def ephemeral_low():
    """First port of the range the kernel hands out to programs that just want to talk to a server."""
    try:
        return int((rd("/proc/sys/net/ipv4/ip_local_port_range", "") or "32768 60999").split()[0])
    except ValueError:
        return 32768


def listening():
    """(ports that something really offers to the network, number of temporary UDP sockets).
    Browsers open UDP sockets in the ephemeral range (QUIC, WebRTC): they only talk, they do not accept connections."""
    seen, temp, low = [], set(), ephemeral_low()
    for ln in run("ss", "-H", "-tuln").splitlines():
        p = ln.split()
        if len(p) < 5:
            continue
        proto, state, local = p[0], p[1], p[4]
        if proto == "tcp" and state != "LISTEN":
            continue
        host, _, port = local.rpartition(":")
        if host.strip("[]").startswith("127.") or host.strip("[]") == "::1":
            continue
        if proto == "udp" and port.isdigit() and int(port) >= low:
            temp.add(port)
            continue
        item = f"{proto}/{port}"
        if item not in seen:
            seen.append(item)
    return seen, len(temp)


def checks():
    """[(name, value, status, explanation)]  status: ok | warn | info"""
    c = []
    toks = set((rd("/proc/cmdline", "") or "").split())

    swaps = [ln for ln in (rd("/proc/swaps", "") or "").splitlines()[1:] if ln.strip()]
    c.append(("Swap", "off" if not swaps else f"ON ({len(swaps)})", "ok" if not swaps else "warn",
              "No swap: RAM contents are never written to disk. The live system only uses swap if asked to (swap=true)."))

    v6 = os.path.exists("/proc/sys/net/ipv6")
    c.append(("IPv6", "enabled" if v6 else "disabled", "info" if v6 else "ok",
              "Boot option ipv6.disable=1 removes the IPv6 stack: smaller network attack surface. "
              "The 'compatibility' boot entry keeps it on."))

    present = [f for f in HARDEN_FLAGS if f in toks]
    c.append(("Hardened boot options", f"{len(present)}/{len(HARDEN_FLAGS)}",
              "ok" if len(present) == len(HARDEN_FLAGS) else "info",
              "Memory is wiped on allocation and free, allocator caches are not merged or predictable, "
              "legacy vsyscall, debugfs and TSX are off."))

    for name, key, good, text in (
        ("Kernel pointers hidden", "kernel.kptr_restrict", {"2"}, "Kernel addresses are hidden from every user (kptr_restrict=2)."),
        ("dmesg restricted", "kernel.dmesg_restrict", {"1"}, "Only root can read the kernel log (dmesg_restrict=1)."),
        ("Unprivileged BPF", "kernel.unprivileged_bpf_disabled", {"1", "2"}, "Normal users cannot load BPF programs into the kernel."),
        ("ptrace limited", "kernel.yama.ptrace_scope", {"1", "2", "3"}, "A process cannot read the memory of another one it did not start (Yama)."),
    ):
        val = sysctl(key)
        c.append((name, val if val is not None else "n/a", "ok" if val in good else "warn", text))

    cp = sysctl("kernel.core_pattern") or ""
    c.append(("Core dumps", "off" if cp.startswith("|/bin/false") else "on", "ok" if cp.startswith("|/bin/false") else "warn",
              "Crashing programs leave no memory dump on disk."))

    aa = rd("/sys/module/apparmor/parameters/enabled")
    c.append(("AppArmor", "enabled" if aa == "Y" else "off", "ok" if aa == "Y" else "warn",
              "Mandatory access control confines programs that ship an AppArmor profile."))

    lock = rd("/sys/kernel/security/lockdown", "") or ""
    m = re.search(r"\[(\w+)\]", lock)
    c.append(("Kernel lockdown", m.group(1) if m else "n/a", "info",
              "Not forced on purpose: it would block proprietary drivers such as NVIDIA's."))

    port = ssh_port()
    for unit, label, text in (
        ("nftables", "Firewall (nftables)", "Default-deny in and out. See the Network tab."),
        ("ssh", "SSH server", f"Port {port}, keys only, no root, only members of group 'sshusers' (nobody yet)."),
        ("fail2ban", "fail2ban", "Bans an address for 1 hour after 3 failed SSH logins in 10 minutes."),
    ):
        st = run("systemctl", "is-active", unit) or "unknown"
        if unit == "ssh" and st != "active" and (run("systemctl", "is-enabled", unit) or "") in ("disabled", "masked"):
            c.append((label, "off", "ok", "Switched off: nothing listens for SSH. To use it, see the Network tab."))
            continue
        c.append((label, st, "ok" if st == "active" else "warn", text))

    hids = run("systemctl", "is-active", "sysctl-helper") or "unknown"
    c.append(("HIDS", hids, "ok" if hids == "active" else "warn",
              "File integrity monitor: it checks the system programs (bin, sbin, usr/bin, usr/local/bin) and "
              "/etc/passwd, shadow and sudoers against a recorded baseline, then watches them live. Changes go to "
              "/var/log/hids.log and a notification; package updates are recognised and not flagged."))

    vdir = "/sys/devices/system/cpu/vulnerabilities"
    try:
        states = {n: (rd(os.path.join(vdir, n), "") or "") for n in os.listdir(vdir)}
    except OSError:
        states = {}
    if states:
        bad = sorted(n for n, v in states.items() if v.startswith("Vulnerable"))
        c.append(("CPU vulnerabilities", "none open" if not bad else f"{len(bad)} open", "ok" if not bad else "warn",
                  f"Kernel mitigations checked for {len(states)} known CPU flaws." + (f" Open: {', '.join(bad)}." if bad else "")))
    mc = rd("/sys/devices/system/cpu/cpu0/microcode/version")
    if mc:
        c.append(("CPU microcode", mc, "info", "Revision loaded at boot; intel-microcode and amd64-microcode keep it current."))

    live = "boot=live" in toks
    al = gdm_autologin()
    if live:
        c.append(("Automatic login", "live session", "info",
                  "The live session logs in by itself, by design. An installed system never does."))
    elif al:
        c.append(("Automatic login", "ON", "warn",
                  "The login screen lets someone in WITHOUT a password (" + ", ".join(al) + "). Put a # before those lines in "
                  "/etc/gdm3/daemon.conf and /etc/gdm3/custom.conf and restart."))
    else:
        c.append(("Automatic login", "off", "ok", "Nobody gets in without typing a password."))

    ports, temp = listening()
    expected = {f"tcp/{port}", "udp/68"}
    extra = [p for p in ports if p not in expected]
    shown = ", ".join(ports) if ports else "none"
    if temp:
        shown += f" (+{temp} temporary UDP)"
    c.append(("Listening ports", shown, "ok" if not extra else "warn",
              "Everything reachable from the network, read from the kernel right now. Temporary UDP sockets above "
              "port 32768 are programs such as browsers talking to servers: they accept no connections and are not counted."))

    c.append(("Kernel", platform.release(), "info", "Debian's own kernel with security updates (apt)."))
    return c


# ---------------------------------------------------------------- UI helpers
def lab(text, cls, wrap=False, selectable=False):
    w = Gtk.Label(label=text)
    w.set_xalign(0)
    w.get_style_context().add_class(cls)
    if wrap:
        w.set_line_wrap(True)
        w.set_max_width_chars(70)
    w.set_selectable(selectable)
    return w


def page():
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    box.set_border_width(14)
    sw = Gtk.ScrolledWindow()
    sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    sw.add(box)
    return sw, box


