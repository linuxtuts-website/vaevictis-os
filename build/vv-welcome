        self.set_border_width(20)

        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.add(root)
        root.pack_start(lab("VAEVICTIS OS", "brand"), False, False, 0)
        root.pack_start(lab("Hardened live environment", "title"), False, False, 0)
        root.pack_start(lab(f"Kernel {platform.release()}  \u00b7  Debian 13  \u00b7  Stateless. Stealth. Brutal.", "sub"), False, False, 0)

        self.nb = Gtk.Notebook()
        root.pack_start(self.nb, True, True, 6)

        self.sec_scroll, self.sec_box = page()
        self.nb.append_page(self.sec_scroll, Gtk.Label(label="SECURITY"))
        self.nb.append_page(self._network_page(), Gtk.Label(label="NETWORK"))
        self.nb.append_page(self._apps_page(), Gtk.Label(label="APPS"))
        self._fill_security()

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        site = Gtk.LinkButton.new_with_label("https://linuxtuts.online", "linuxtuts.online")
        site.set_relief(Gtk.ReliefStyle.NONE)
        row.pack_start(site, False, False, 0)
        refresh = Gtk.Button(label="REFRESH")
        refresh.connect("clicked", lambda *_: self._fill_security())
        row.pack_end(refresh, False, False, 0)
        ok = Gtk.Button(label="GOT IT")
        ok.get_style_context().add_class("primary")
        ok.connect("clicked", self.on_close)
        row.pack_end(ok, False, False, 0)
        root.pack_start(row, False, False, 4)

    # ---- tabs
    def _fill_security(self):
        for ch in self.sec_box.get_children():
            self.sec_box.remove(ch)
        self.sec_box.pack_start(lab("LIVE STATUS, READ FROM THIS RUNNING SYSTEM", "h"), False, False, 0)
        for name, value, status, text in checks():
            head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            head.pack_start(lab("\u25cf", status), False, False, 0)
            head.pack_start(lab(name, "name"), False, False, 0)
            v = lab(value, "val")
            v.set_xalign(1)
            v.set_ellipsize(3)
            head.pack_end(v, True, True, 0)
            self.sec_box.pack_start(head, False, False, 0)
            self.sec_box.pack_start(lab(text, "dim", wrap=True), False, False, 0)
        self.sec_box.show_all()

