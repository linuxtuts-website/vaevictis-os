#!/usr/bin/env bash
# vv-look - the 1.3 look of the desktop, in the VaeVictis chroot. Only Debian packages and settings, no program of ours:
#
#   1. icons: the VaeVictis-Dark theme (build/icons: folders and app icons drawn for VaeVictis) on top of Papirus-Dark,
#      which gives every other icon (package papirus-icon-theme)
#   2. Blur my Shell (package gnome-shell-extension-blur-my-shell): the wallpaper, blurred, behind the overview and the
#      app grid. It is switched on in vv-branding, where the one list of enabled extensions is written
#   3. Ptyxis (package ptyxis) is the terminal; GNOME Terminal is not in the image any more
#   4. GNOME's dark style by default (each user can switch it in Settings > Appearance)
#
#   vv-look            apply (safe to repeat; replaced files are backed up next to the chroot)
#
# Run it after vv-apps and before vv-branding. Everything here is a default: what a user sets in Settings wins.
set -euo pipefail

HERE="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
CH="${VV_CHROOT:-/run/media/user/Mio/Backup_VaeVictis_Completo/vaevictis/new/chroot}"
CH="$(realpath -m "$CH")"
VVC="$HERE/vv-chroot"
THEME_SRC="$HERE/icons/VaeVictis-Dark"
PKGS="papirus-icon-theme gnome-shell-extension-blur-my-shell ptyxis"

die() { echo "vv-look: $*" >&2; exit 1; }
# (test mode, VV_SKIP_CHROOT=1, only writes into the folder given as VV_CHROOT: no root needed)
[ "$(id -u)" -eq 0 ] || [ -n "${VV_SKIP_CHROOT:-}" ] || exec sudo -E VV_CHROOT="$CH" "$0" "$@"
[ -f "$CH/etc/debian_version" ] && [ "$CH" != "/" ] || die "not a Debian root filesystem: $CH"
[ -x "$VVC" ] || [ -n "${VV_SKIP_CHROOT:-}" ] || die "vv-chroot must be next to this script ($VVC)"
[ -f "$THEME_SRC/index.theme" ] || die "the icon theme must be next to this script ($THEME_SRC)"

BK="$(dirname "$CH")/vv-backups/$(date +%Y%m%d-%H%M%S)"
bak() { local rel="${1#$CH/}"; [ -e "$1" ] || return 0; mkdir -p "$BK"; (cd "$CH" && cp -a --parents "$rel" "$BK/"); }
in_chroot() {
    if [ -n "${VV_SKIP_CHROOT:-}" ]; then echo "  [skipped in test] $(echo "$1" | head -c 200)"; return 0; fi
    "$VVC" run /bin/sh -c "$1"
}
installed() { [ -n "${VV_SKIP_CHROOT:-}" ] && return 0
              "$VVC" run dpkg-query -W -f='${db:Status-Abbrev}' "$1" 2>/dev/null | grep -q '^ii'; }

echo "== Debian packages of the look"
missing=""
for p in $PKGS; do installed "$p" || missing="$missing $p"; done
[ -z "$missing" ] || die "install them in the chroot first:  ./vv-chroot run apt-get install -y$missing"
echo "  $PKGS: installed"
if [ -z "${VV_SKIP_CHROOT:-}" ] && installed gnome-terminal; then
    die "GNOME Terminal is still in the chroot (Ptyxis replaces it):  ./vv-chroot run apt-get purge -y gnome-terminal gnome-terminal-data"
fi
echo "  gnome-terminal: not installed (Ptyxis is the terminal)"

echo "== icons: VaeVictis-Dark on top of Papirus-Dark"
DEST="$CH/usr/share/icons/VaeVictis-Dark"
[ -d "$DEST" ] && { bak "$DEST"; rm -rf "$DEST"; }
install -d -m 0755 "$DEST"
(cd "$THEME_SRC" && find . -type d) | while read -r d; do install -d -m 0755 "$DEST/$d"; done
(cd "$THEME_SRC" && find . -type f) | while read -r f; do install -m 0644 "$THEME_SRC/$f" "$DEST/$f"; done
echo "  /usr/share/icons/VaeVictis-Dark: $(find "$DEST" -name '*.svg' | wc -l) icons"

echo "== defaults (dconf): icon theme, dark style"
install -d -m 0755 "$CH/etc/dconf/db/vaevictis.d"
bak "$CH/etc/dconf/db/vaevictis.d/20-look-vaevictis"
cat > "$CH/etc/dconf/db/vaevictis.d/20-look-vaevictis" <<'EOF'
# VaeVictis 1.3 look (generated by vv-look). Defaults only: Settings > Appearance changes them for each user.
[org/gnome/desktop/interface]
icon-theme='VaeVictis-Dark'
color-scheme='prefer-dark'
EOF
chmod 0644 "$CH/etc/dconf/db/vaevictis.d/20-look-vaevictis"

echo "== inside the chroot: icon caches, dconf"
in_chroot "
gtk-update-icon-cache -q -f -t /usr/share/icons/VaeVictis-Dark || echo '  gtk-update-icon-cache not found (package libgtk-3-bin)'
dconf update && echo '  dconf database updated'
"

cat <<EOF

Done. Backups of replaced files: $BK (only if something was replaced)
Next: ./vv-branding (it switches Blur my Shell on, with the other extensions).
To undo in a chroot: remove /usr/share/icons/VaeVictis-Dark and /etc/dconf/db/vaevictis.d/20-look-vaevictis, then dconf update.
EOF
