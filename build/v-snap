#!/bin/bash
# VaeVictis Snap - hardlink snapshots for ext4 (installed systems only)
# Usage: sudo v-snap [snapshot-directory]

[ "$EUID" -eq 0 ] || { echo "Insufficient permissions. Run with: sudo v-snap"; exit 1; }

if [ -n "${1:-}" ]; then
    SNAP_DIR="${1%/}"
elif mountpoint -q /home; then
    SNAP_DIR="/home/.vaevictis-snapshots"
else
    SNAP_DIR="/.vaevictis-snapshots"
fi

command -v rsync >/dev/null 2>&1 || { echo "rsync is not installed: sudo apt-get install rsync"; exit 1; }

# ---- folder picker -------------------------------------------------------------------------
# v-snap runs as root (sudo), and root cannot open windows on your screen. So the dialog is started AS THE USER
# who ran sudo, inside that user's desktop session. It prints the chosen folder, or nothing (cancelled / no desktop).
PICKER_PY='
import os, sys
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk
title, start = sys.argv[1], sys.argv[2]
d = Gtk.FileChooserDialog(title=title, action=Gtk.FileChooserAction.SELECT_FOLDER)
d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Select this folder", Gtk.ResponseType.OK)
d.set_default_response(Gtk.ResponseType.OK)
d.set_keep_above(True)
if os.path.isdir(start):
    d.set_current_folder(start)
if d.run() == Gtk.ResponseType.OK:
    print(d.get_filename())
d.destroy()
'

pick_folder() {      # pick_folder "window title"
    if [ -n "${VV_SNAP_PICK:-}" ]; then printf '%s\n' "$VV_SNAP_PICK"; return 0; fi    # test hook (root only)
    local uid user home rt sock start env
    uid="${SUDO_UID:-${PKEXEC_UID:-}}"
    [ -n "$uid" ] && [ "$uid" != 0 ] || return 0
    user="$(id -nu "$uid" 2>/dev/null)" || return 0
    home="$(getent passwd "$user" | cut -d: -f6)"
    rt="/run/user/$uid"
    [ -d "$rt" ] || return 0
    env=(HOME="$home" XDG_RUNTIME_DIR="$rt" DBUS_SESSION_BUS_ADDRESS="unix:path=$rt/bus")
    for sock in "$rt"/wayland-*; do
        case "$sock" in *.lock) continue ;; esac
        if [ -S "$sock" ]; then env+=(WAYLAND_DISPLAY="${sock##*/}"); break; fi
    done
    [ -S /tmp/.X11-unix/X0 ] && env+=(DISPLAY=":0")
    start="$home"; [ -d "/media/$user" ] && start="/media/$user"        # plugged-in disks and sticks live here
    runuser -u "$user" -- env "${env[@]}" python3 -c "$PICKER_PY" "$1" "$start" 2>/dev/null || true
}

# The chosen folder only CONTAINS the snapshots: they go in a '.vaevictis-snapshots' folder inside it, so that
# picking the top of a disk never changes the permissions of the whole disk.
choose_storage() {
    local ans dir
    echo -e "\nSnapshot storage: $SNAP_DIR"
    echo "  On the system disk it protects from a bad update only; on an external disk it also protects from a disk failure."
    read -rp "Press ENTER to keep it, B to browse for a folder (disk, USB stick...), or type a full path: " ans
    case "$ans" in
        "")   return 0 ;;
        [bB]) dir="$(pick_folder "Where to keep the snapshots")"
              [ -n "$dir" ] || { echo "No folder chosen (cancelled, or no desktop): keeping $SNAP_DIR"; return 0; } ;;
        /*)   dir="$ans" ;;
        *)    echo "Not a full path (it must start with /): keeping $SNAP_DIR"; return 0 ;;
    esac
    dir="${dir%/}"
    case "$dir" in */.vaevictis-snapshots) ;; *) dir="$dir/.vaevictis-snapshots" ;; esac
    SNAP_DIR="$dir"
    echo "Snapshots will be kept in: $SNAP_DIR"
}

# create the folder, check the filesystem, build the list of what a system snapshot leaves out
setup_storage() {
    mkdir -p "$SNAP_DIR" || { echo "Cannot create $SNAP_DIR"; return 1; }
    chmod 700 "$SNAP_DIR"
    FSTYPE=$(findmnt -no FSTYPE -T "$SNAP_DIR")
    case "$FSTYPE" in
        ext4|ext3|xfs|btrfs) ;;
        *) echo "Unsupported filesystem '$FSTYPE' for $SNAP_DIR (needs Linux permissions and hardlinks)."; return 1 ;;
    esac
    # /home is never part of a system snapshot: use option 2 for it
    SYS_EXCLUDES=(--exclude="/dev/*" --exclude="/proc/*" --exclude="/sys/*" --exclude="/tmp/*"
                  --exclude="/run/*" --exclude="/mnt/*" --exclude="/media/*" --exclude="/lost+found"
                  --exclude="/boot/efi/*" --exclude="/home/*" --exclude="/swapfile"
                  --exclude="$SNAP_DIR")
}

if [ -n "${1:-}" ]; then :; else choose_storage; fi       # a folder given on the command line is used as it is
setup_storage || exit 1

ts()        { date +%Y-%m-%d_%H-%M-%S; }
hum()       { numfmt --to=iec --from-unit=1024 "$1"; }
avail_kb()  { df --output=avail -k "$SNAP_DIR" | tail -n 1 | tr -d ' '; }
used_kb()   { df --output=used -k / | tail -n 1 | tr -d ' '; }
sys_snaps() { find "$SNAP_DIR" -maxdepth 1 -type d -name 'sys-snap-*' ! -name '*.partial' | sort; }

clean_partials() {
    local p
    for p in "$SNAP_DIR"/*.partial; do
        [ -d "$p" ] || continue
        echo "Removing leftover partial snapshot: $(basename "$p")"
        rm -rf "$p"
    done
}

# $1 = rsync exit code, $2 = .partial path, $3 = final path
finish() {
    if [ "$1" -eq 0 ] || [ "$1" -eq 24 ]; then
        mv "$2" "$3" && echo -e "\n✓ Completed: $3"
    else
        echo -e "\n✗ rsync failed (exit $1). Snapshot NOT saved."
        rm -rf "$2"
    fi
}

snap_system() {
    clean_partials
    local latest need link=()
    latest=$(sys_snaps | tail -n 1)
    if [ -n "$latest" ]; then
        echo "Previous snapshot: $(basename "$latest"). Only changed files use new space."
        link=(--link-dest="$latest")
        need=1048576
    else
        need=$(used_kb)
        echo "First snapshot: full copy of / (up to $(hum "$need"), /home excluded)."
    fi
    if [ "$(avail_kb)" -lt "$need" ]; then
        echo "Not enough free space on $SNAP_DIR: $(hum "$(avail_kb)") free, at least $(hum "$need") needed."
        return
    fi
    local dest="$SNAP_DIR/sys-snap-$(ts)"
    trap 'echo' INT
    rsync -aHAXx --numeric-ids --info=progress2 "${link[@]}" "${SYS_EXCLUDES[@]}" / "$dest.partial/"
    finish $? "$dest.partial" "$dest"
    trap - INT
}

snap_folder() {
    clean_partials
    local src name latest need dest excl=() link=()
    read -rp "Folder to back up: B to browse, or type the full path (e.g. /home): " src
    case "$src" in
        [bB]) src="$(pick_folder "Folder to back up")"
              [ -n "$src" ] || { echo "No folder chosen (cancelled, or no desktop)."; return; } ;;
    esac
    [ -n "$src" ] || { echo "Cancelled."; return; }
    src=$(realpath -m "$src")
    [ -d "$src" ] || { echo "Error: folder not found!"; return; }
    [ "$src" = "/" ] && { echo "Use option 1 for the whole system."; return; }
    case "$src/" in "$SNAP_DIR"/*) echo "Cannot back up the snapshot directory itself."; return ;; esac
    case "$SNAP_DIR/" in "$src"/*) excl+=(--exclude="${SNAP_DIR#"$src"}") ;; esac
    case "$src" in
        /home|/home/*) excl+=(--exclude=".cache/" --exclude=".local/share/Trash/")
                       echo "Skipping .cache and Trash folders." ;;
    esac
    name=$(printf '%s' "$(basename "$src")" | tr -c 'A-Za-z0-9_.-' '_')
    latest=$(find "$SNAP_DIR" -maxdepth 1 -type d -regextype posix-extended \
             -regex ".*/dir-snap-$name-[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}" | sort | tail -n 1)
    if [ -n "$latest" ]; then
        echo "Previous backup: $(basename "$latest"). Only changed files use new space."
        link=(--link-dest="$latest")
        need=1048576
    else
        echo "Calculating folder size..."
        need=$(du -sk "$src" 2>/dev/null | cut -f1)
        echo "First backup of this folder: about $(hum "$need")."
    fi
    if [ "$(avail_kb)" -lt "$need" ]; then
        echo "Not enough free space on $SNAP_DIR: $(hum "$(avail_kb)") free, at least $(hum "$need") needed."
        return
    fi
    dest="$SNAP_DIR/dir-snap-$name-$(ts)"
    trap 'echo' INT
    rsync -aHAX --numeric-ids --info=progress2 "${link[@]}" "${excl[@]}" "$src/" "$dest.partial/"
    finish $? "$dest.partial" "$dest"
    trap - INT
    echo "To restore it: rsync -aHAX $dest/ $src/"
}

list_snaps() {
    echo -e "\nSnapshots in $SNAP_DIR ($FSTYPE, $(hum "$(avail_kb)") free):"
    SNAPS=()
    local s i=0
    while IFS= read -r s; do SNAPS+=("$s"); done < <(find "$SNAP_DIR" -maxdepth 1 -type d \( -name 'sys-snap-*' -o -name 'dir-snap-*' \) | sort)
    if [ ${#SNAPS[@]} -eq 0 ]; then echo "  (none)"; return 1; fi
    for s in "${SNAPS[@]}"; do i=$((i + 1)); printf "  %2d) %s\n" "$i" "$(basename "$s")"; done
    echo "Real space used (hardlinked files counted once): $(du -sh "$SNAP_DIR" | cut -f1)"
}

delete_snap() {
    list_snaps || return
    local n target a
    read -rp "Number to delete (empty = cancel): " n
    if ! { [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "${#SNAPS[@]}" ]; }; then
        echo "Cancelled."; return
    fi
    target="${SNAPS[$((n - 1))]}"
    read -rp "Delete $(basename "$target")? [y/N]: " a
    if [[ "$a" =~ ^[Yy]$ ]]; then
        rm -rf -- "$target" && echo "✓ Deleted. Other snapshots are not affected (shared files are hardlinks)."
    else
        echo "Cancelled."
    fi
}

restore_snap() {
    local SYS=() s i=0 n src c
    while IFS= read -r s; do SYS+=("$s"); done < <(sys_snaps)
    [ ${#SYS[@]} -gt 0 ] || { echo "No system snapshots found."; return; }
    echo -e "\nSystem snapshots:"
    for s in "${SYS[@]}"; do i=$((i + 1)); printf "  %2d) %s\n" "$i" "$(basename "$s")"; done
    read -rp "Number to restore (empty = cancel): " n
    if ! { [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "${#SYS[@]}" ]; }; then
        echo "Cancelled."; return
    fi
    src="${SYS[$((n - 1))]}"
    echo -e "\nThis OVERWRITES the running system with $(basename "$src") and deletes files"
    echo "created after it. /home, /etc/fstab and the EFI partition are NOT touched."
    echo "Save your work first and reboot right after."
    read -rp "Type RESTORE to continue: " c
    [ "$c" = "RESTORE" ] || { echo "Cancelled."; return; }
    rsync -aHAXx --numeric-ids --delete --info=progress2 \
        "${SYS_EXCLUDES[@]}" --exclude="/etc/fstab" "$src/" /
    echo -e "\n✓ Restore finished (rsync exit $?). Reboot now: sudo reboot"
}

while true; do
    echo
    echo "========================================"
    echo "          VaeVictis Snap Utility        "
    echo "========================================"
    echo " Storage: $SNAP_DIR"
    echo " (same disk: protects from bad updates, not from disk failure)"
    echo "----------------------------------------"
    echo " 1) System snapshot (incremental, /home excluded)"
    echo " 2) Folder backup (e.g. /home)"
    echo " 3) List snapshots"
    echo " 4) Delete a snapshot"
    echo " 5) Restore a system snapshot"
    echo " 6) Exit"
    echo " 7) Change the storage location"
    echo "========================================"
    read -rp "Choose an option [1-7]: " choice
    case "$choice" in
        1) snap_system ;;
        2) snap_folder ;;
        3) list_snaps || true ;;
        4) delete_snap ;;
        5) restore_snap ;;
        6) exit 0 ;;
        7) old_dir="$SNAP_DIR"; choose_storage
           if [ "$SNAP_DIR" != "$old_dir" ] && ! setup_storage; then SNAP_DIR="$old_dir"; setup_storage || exit 1; fi ;;
        *) echo "Invalid option." ;;
    esac
done
