    def setup_ipc(self, lock_socket):
        self.lock_socket = lock_socket
        self.notifier = QSocketNotifier(self.lock_socket.fileno(), QSocketNotifier.Type.Read, self)
        self.notifier.activated.connect(self._handle_ipc)

    def _handle_ipc(self):
        try:
            data, _ = self.lock_socket.recvfrom(4096)
            msg = data.decode('utf-8')
            if msg.startswith(RAISE_PREFIX):
                # a second launch asks us to show ourselves, and waits for the answer
                self.showNormal()
                self.raise_()
                self.activateWindow()
                self.lock_socket.sendto(b'OK', '\0' + msg[len(RAISE_PREFIX):])
            elif os.path.exists(msg):
                self.open_external_file(msg)
        except Exception:
            pass

    def open_external_file(self, path):
        meta = self._get_meta(path)
        self.conn.execute('INSERT OR IGNORE INTO tracks (path,title,artist,duration) VALUES (?,?,?,?)',
            (path, meta['title'], meta['artist'], meta['duration']))
        self.conn.commit()
        
        self.sidebar.setCurrentRow(0)
        self._load_current_view()
        self.play(path)

