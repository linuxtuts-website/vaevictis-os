    def add_folder(self):
        folder = QFileDialog.getExistingDirectory(self, "Select Music Folder", self.last_dir)
        if folder:
            self.last_dir = folder
            valid_exts = {'.mp3', '.flac', '.ogg', '.wav'}
            files_to_add = []
            for root, _, files in os.walk(folder):
                for file in files:
                    if os.path.splitext(file)[1].lower() in valid_exts:
                        files_to_add.append(os.path.join(root, file))
            self._import_and_link(files_to_add)
    
    def _connect_spectrum(self):
        """Give the spectrum the real audio that is playing (needs Qt 6.8 or newer)."""
        ok = False
        if USE_QT and self.player and HAS_AUDIO_TAP:
            try:
                self.audio_tap = QAudioBufferOutput(self)
                self.player.setAudioBufferOutput(self.audio_tap)
                self.audio_tap.audioBufferReceived.connect(self.visualizer.feed)
                self.visualizer.set_clock(lambda: (self.player.position(), self.player.playbackRate()))
                ok = True
            except Exception:
                ok = False
        self.visualizer.set_available(ok)

    def fmt_time(self, s):
        if not s or s <= 0:
            return "0:00"
        td = timedelta(seconds=int(s))
        total_seconds = int(td.total_seconds())
        mins = total_seconds // 60
        secs = total_seconds % 60
        return f"{mins}:{secs:02d}"
    
    def play(self, path):
        if not os.path.exists(path):
            QMessageBox.warning(self, "Offline", "Track is offline.")
            return

        meta = self._get_meta(path)
        self.lbl_info.setText(f"<span style='font-weight:bold; font-size:14px; color:#ffffff;'>{meta['title']}</span><br><span style='color:#a0a0a5; font-size:12px; font-weight:normal;'>{meta['artist']}</span>")
        
        try:
            icon_arg = self.icon_path if os.path.exists(self.icon_path) else 'multimedia-audio-player'
            subprocess.Popen(['notify-send', '-a', 'Aurora', '-i', icon_arg, meta['title'], meta['artist']])
        except Exception:
            pass
        
        if USE_QT and self.player:
            from PyQt6.QtCore import QUrl
            self.visualizer.clear()
            self.player.setSource(QUrl.fromLocalFile(path))
            self.player.play()
    
    def toggle_play(self):
        if USE_QT and self.player:
            if not self.player.source().isValid():
                if self.playlist:
                    self.play(self.playlist[0])
                return
            state = self.player.playbackState()
            if state == QMediaPlayer.PlaybackState.PlayingState:
                self.player.pause()
            else:
                self.player.play()
    
    def _on_state_changed(self, state):
        if state == QMediaPlayer.PlaybackState.PlayingState:
            self.btn_play.setText("Pause")
            self.visualizer.set_playing(True)
        else:
            self.btn_play.setText("Play")
            self.visualizer.set_playing(False)

    def stop(self):
        if USE_QT and self.player:
            self.player.stop()
            self.progress.setValue(0)
            self.time_cur.setText("0:00")
            self.visualizer.set_playing(False)
    
    def next(self):
        if len(self.playlist) > 0:
            if self.btn_shuffle.isChecked():
                idx = random.randint(0, len(self.playlist) - 1)
            else:
                try:
                    current = self.player.source().toLocalFile() if self.player.source().isValid() else self.playlist[0]
                    idx = (self.playlist.index(current) + 1) % len(self.playlist)
                except ValueError:
                    idx = 0
            self.play(self.playlist[idx])
    
    def prev(self):
        if len(self.playlist) > 0:
            try:
                current = self.player.source().toLocalFile() if self.player.source().isValid() else self.playlist[0]
                idx = (self.playlist.index(current) - 1) % len(self.playlist)
            except ValueError:
                idx = 0
            self.play(self.playlist[idx])
    
    def set_vol(self, v):
        if USE_QT and self.audio:
            self.audio.setVolume(v / 100.0)

    def set_speed(self, v):
        rate = v / 100.0
        self.lbl_speed_val.setText(f"{rate:.1f}x")
        if USE_QT and self.player:
            self.player.setPlaybackRate(rate)
    
    def _on_slider_pressed(self):
        self.is_seeking = True

    def _on_seek(self):
        if USE_QT and self.player:
            self.player.setPosition(self.progress.value())
        self.is_seeking = False
    
    def _on_position_changed(self, pos):
        dur = self.player.duration()
        if dur > 0:
            self.progress.setMaximum(dur)
            if not self.is_seeking:
                self.progress.setValue(pos)
            self.time_cur.setText(self.fmt_time(pos / 1000))
            self.time_tot.setText(self.fmt_time(dur / 1000))

    def _on_media_status_changed(self, status):
        if USE_QT and status == QMediaPlayer.MediaStatus.EndOfMedia:
            if self.btn_repeat.isChecked():
                self.player.setPosition(0)
                self.player.play()
            else:
                self.next()
    
