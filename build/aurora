class SpectrumAnalyzer(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setMinimumHeight(120)
        self.num_bars = 45
        self.values = [0.0] * self.num_bars
        self.targets = [0.0] * self.num_bars
        self.is_playing = False
        
        self.timer = QTimer(self)
        self.timer.timeout.connect(self._animate)
        self.timer.start(50)

    def set_playing(self, state):
        self.is_playing = state
        if not state:
            self.targets = [0.0] * self.num_bars

    def _animate(self):
        if self.is_playing:
            for i in range(self.num_bars):
                if random.random() > 0.7:
                    multiplier = 1.0 - abs((i - self.num_bars/2) / (self.num_bars/2))
                    self.targets[i] = random.uniform(0.1, 1.0) * (0.4 + 0.6 * multiplier)
        
        needs_update = False
        for i in range(self.num_bars):
            diff = self.targets[i] - self.values[i]
            if abs(diff) > 0.01:
                self.values[i] += diff * 0.3
                needs_update = True
                
        if needs_update or self.is_playing:
            self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        
        w = self.width()
        h = self.height()
        bar_w = w / self.num_bars
        padding = max(1, bar_w * 0.2)
        actual_w = bar_w - padding
        
        painter.setPen(Qt.PenStyle.NoPen)
        for i in range(self.num_bars):
            bar_h = self.values[i] * h * 0.8
            x = i * bar_w + padding / 2
            y = h - bar_h
            
            intensity = int(100 + 155 * self.values[i])
            color = QColor(intensity, intensity, intensity, 220)
            painter.setBrush(QBrush(color))
            painter.drawRoundedRect(int(x), int(y), int(actual_w), int(bar_h), 2, 2)


