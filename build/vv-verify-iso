#!/usr/bin/env bash
# vv-verify-iso - check a finished VaeVictis ISO before you flash or upload it. Read-only: nothing is changed.
#
#   vv-verify-iso /path/to/vaevictis-DATE.iso        (mounts the ISO read-only, needs root)
#   vv-verify-iso /path/to/filesystem.squashfs       (only the system image: no ISO structure checks)
#
# Prints OK / FAIL for every check and ends with the SHA-256. Exit status 1 if anything failed.
# Keep it next to the other scripts of build/: the VaeVictis files in the image are compared byte for byte with them.
set -euo pipefail

die() { echo "vv-verify-iso: $*" >&2; exit 1; }
ISO="${1:-}"
[ -n "$ISO" ] && [ -f "$ISO" ] || die "usage: vv-verify-iso FILE.iso"
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
command -v unsquashfs >/dev/null 2>&1 || die "missing tool: unsquashfs (apt install squashfs-tools)"

M="$(mktemp -d)"; W="$(mktemp -d)"; MOUNTED=0
cleanup() { [ "$MOUNTED" = 1 ] && umount "$M" 2>/dev/null || true; rmdir "$M" 2>/dev/null || true; rm -rf "$W"; }
trap cleanup EXIT

FAILS=0
ok()   { printf '  OK    %s\n' "$1"; }
bad()  { printf '  FAIL  %s\n' "$1"; FAILS=$((FAILS + 1)); }
head_() { printf '\n== %s\n' "$1"; }

case "$ISO" in
    *.squashfs) SQ="$ISO"; IS_ISO=0 ;;
    *) mount -o loop,ro "$ISO" "$M"; MOUNTED=1; SQ="$M/live/filesystem.squashfs"; IS_ISO=1 ;;
esac
[ -f "$SQ" ] || die "no live/filesystem.squashfs inside"

unsquashfs -ll "$SQ" > "$W/list" 2>/dev/null || die "unsquashfs cannot read the image"
HERE="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
size_of() { awk -v p="squashfs-root/$1" '$NF == p { print $3; exit }' "$W/list"; }
exists()  { awk -v p="squashfs-root/$1" '$NF == p { f = 1; exit } END { exit !f }' "$W/list"; }
cat_of()  { unsquashfs -cat "$SQ" "$1" 2>/dev/null; }
pkg_ok()  { cat_of var/lib/dpkg/status | awk -v pkg="$1" '
    BEGIN { RS = ""; FS = "\n" }
    { p = ""; s = ""; for (i = 1; i <= NF; i++) { if ($i ~ /^Package: /) p = substr($i, 10); if ($i ~ /^Status: /) s = $i }
      if (p == pkg && s == "Status: install ok installed") f = 1 }
    END { exit !f }'; }

head_ "ISO structure"
if [ "$IS_ISO" = 1 ]; then
    for f in live/vmlinuz live/initrd.img boot/grub/grub.cfg; do
        [ -e "$M/$f" ] && ok "$f" || bad "$f is missing"
    done
    # UEFI: older grub-mkrescue puts boot/grub/efi.img in the ISO, newer ones append an EFI partition
    if [ -e "$M/boot/grub/efi.img" ]; then ok "UEFI boot image (boot/grub/efi.img)"
    elif fdisk -l "$ISO" 2>/dev/null | grep -E "^${ISO}[0-9]" | grep -qi efi; then ok "UEFI boot partition (EFI partition appended to the ISO)"
    else bad "no UEFI boot image and no EFI partition: this ISO would not boot on UEFI PCs"; fi
    [ -d "$M/boot/grub/i386-pc" ] && ok "BIOS boot files (boot/grub/i386-pc)" || bad "no BIOS boot files"
    grep -q 'boot=live' "$M/boot/grub/grub.cfg" && ok "live menu entries present" || bad "grub.cfg has no live entry"
    grep -qw 'quiet' "$M/boot/grub/grub.cfg" && bad "grub.cfg still has quiet (boot messages hidden)" || ok "boot messages visible (no quiet)"
    if [ -f "$M/boot/grub/themes/vaevictis/theme.txt" ] && [ -f "$M/boot/grub/themes/vaevictis/logo.png" ]; then
        cmp -s "$M/boot/grub/themes/vaevictis/theme.txt" "$HERE/boot/grub-theme.txt" \
            && ok "live menu theme: style A (same theme.txt as build/boot)" || bad "live menu theme.txt differs from build/boot/grub-theme.txt"
        [ "$(ls "$M/boot/grub/themes/vaevictis/"*.pf2 2>/dev/null | wc -l)" = 5 ] && ok "live menu fonts (5 IBM Plex .pf2)" || bad "live menu fonts missing"
        grep -q 'set theme=' "$M/boot/grub/grub.cfg" && ok "grub.cfg loads the theme" || bad "grub.cfg does not load the theme"
        grep -qw 'splash' "$M/boot/grub/grub.cfg" && ok "boot screen (splash) on the hardened entries" || bad "no splash: the boot screen is not used"
    else bad "live menu has no theme (plain text menu)"; fi
    if command -v lsinitramfs >/dev/null 2>&1; then
        lsinitramfs "$M/live/initrd.img" 2>/dev/null > "$W/initrd.list" || true
        grep -q 'plymouth/themes/vaevictis/vaevictis.script' "$W/initrd.list" && grep -q 'ibm-plex/IBMPlexSans-Regular.ttf' "$W/initrd.list" \
            && ok "live initramfs: boot screen and its fonts" || bad "live initramfs lacks the boot screen (run vv-boot-theme)"
    else echo "  (lsinitramfs not here: initramfs not checked)"; fi
else
    echo "  (squashfs only: skipped)"
fi

head_ "VaeVictis files: identical to build/ (byte for byte)"
while read -r path src; do
    if ! exists "$path"; then bad "/$path is MISSING"; continue; fi
    [ -f "$HERE/$src" ] || { bad "$src not next to this script: cannot compare /$path"; continue; }
    if cat_of "$path" | cmp -s - "$HERE/$src"; then ok "/$path"
    else bad "/$path differs from build/$src (old version in the chroot?)"; fi
done <<'EOF'
usr/local/bin/vaevictis_install.sh vaevictis_install.sh
usr/local/sbin/vv-grub-password vv-grub-password
usr/local/sbin/vv-grub-theme vv-grub-theme
usr/local/sbin/vv-nvidia vv-nvidia
usr/local/bin/v-snap v-snap
usr/local/bin/vv-vpn vv-vpn
usr/local/libexec/vv-vpn-helper vv-vpn-helper
usr/local/bin/vv-welcome vv-welcome
usr/local/bin/vv-panic vv-panic
usr/local/libexec/vv-panic-action vv-panic-action
usr/local/libexec/vv-sandbox vv-sandbox
usr/local/lib/vaevictis/vv-pdf vv-pdf.py
usr/local/lib/vaevictis/linpaint linpaint.py
usr/bin/aurora aurora
usr/share/vaevictis/grub-theme/theme.txt boot/grub-theme.txt
usr/share/plymouth/themes/vaevictis/vaevictis.script boot/vaevictis.script
usr/share/plymouth/themes/vaevictis/vaevictis.plymouth boot/vaevictis.plymouth
etc/initramfs-tools/hooks/vaevictis-plymouth boot/initramfs-hook
EOF

head_ "Must exist"
for f in usr/share/backgrounds/vaevictis.png usr/share/applications/vv-vpn.desktop usr/bin/ffmpegthumbnailer \
         usr/lib/systemd/system-generators/systemd-cryptsetup-generator etc/nftables.conf; do
    exists "$f" && ok "$f" || bad "$f is missing"
done

head_ "Contents"
nft_conf="$(cat_of etc/nftables.conf)"
[ "$(printf '%s\n' "$nft_conf" | grep -c 'policy drop')" = 2 ] && [ "$(printf '%s\n' "$nft_conf" | grep -c 'policy accept')" = 1 ] \
    && ok "firewall: input drop, forward drop, output accept" || bad "firewall policies are not drop/drop/accept"
printf '%s\n' "$nft_conf" | grep -q vpn_ports && bad "old outbound port list (vpn_ports) still in the firewall" || ok "no old outbound port list"
cat_of usr/local/bin/vaevictis_install.sh | grep -q 'systemd-cryptsetup' && ok "installer checks systemd-cryptsetup" || bad "installer has no systemd-cryptsetup guard"
cat_of usr/local/bin/vaevictis_install.sh | grep -q 'EFI_BEFORE' && ok "installer saves the firmware boot list" || bad "installer lacks the firmware boot list check"
cat_of usr/local/bin/vaevictis_install.sh | grep -q 'sudo_on_live' && ok "installer removes the live polkit rule" || bad "installer keeps the live polkit rule (root without password for 'user')"
cat_of usr/local/bin/vaevictis_install.sh | grep -qE '^for g in .*libvirt' && bad "installer adds the user to libvirt (root without password)" || ok "installer does not add the user to libvirt"
for w in vv-pdf linpaint aurora; do
    cat_of "usr/local/bin/$w" | grep -q 'exec /usr/local/libexec/vv-sandbox' && ok "$w always starts in its sandbox" \
        || bad "/usr/local/bin/$w does not start the sandbox (run vv-apps)"
done
cat_of usr/local/share/applications/aurora.desktop | grep -q '^Exec=/usr/local/bin/aurora' && ok "Aurora's menu entry starts the sandboxed one" \
    || bad "Aurora's menu entry does not start the sandbox (run vv-apps)"
sysc="$(cat_of etc/sysctl.d/90-vaevictis-hardening.conf)"
printf '%s\n' "$sysc" | grep -q 'legacy_tiocsti = 0' && printf '%s\n' "$sysc" | grep -q 'io_uring_disabled = 2' \
    && ok "sysctl: no TIOCSTI, no io_uring" || bad "sysctl: TIOCSTI or io_uring setting missing (run vv-secure)"
cat_of etc/sysctl.d/99-vaevictis-stealth.conf | grep -q 'generated by vv-secure' && ok "stealth sysctl file generated by vv-secure" \
    || bad "stealth sysctl file is the hand-made one (run vv-secure)"
cat_of etc/sudoers.d/99-vv-panic | grep -q '^%sudo ALL=(root) NOPASSWD: /usr/local/libexec/vv-panic-action ""$' \
    && ok "panic sudoers rule: administrators only" || bad "panic sudoers rule is not limited to %sudo (run vv-secure)"
cat_of etc/apt/apt.conf.d/99-vaevictis-no-bloat | grep -q 'Install-Recommends "false"' && ok "apt: no recommends (vv-apps)" \
    || bad "apt no-bloat setting missing (run vv-apps)"
cat_of etc/plymouth/plymouthd.conf | grep -qx 'Theme=vaevictis' && ok "Plymouth default theme: vaevictis" || bad "Plymouth theme is not vaevictis (run vv-boot-theme)"
grep_os="$(cat_of usr/lib/os-release)"
printf '%s\n' "$grep_os" | grep -qx 'VERSION_ID="1.1"' && printf '%s\n' "$grep_os" | grep -q '^HOME_URL="https://vaevictisos.org"' \
    && ok "os-release: 1.1, vaevictisos.org" || bad "os-release is not 1.1 / vaevictisos.org (run vv-branding)"
if exists etc/apt/sources.list.d/vaevictis.sources; then
    pkg_ok vaevictis-archive-keyring && cat_of etc/apt/preferences.d/vaevictis | grep -q 'Pin-Priority: -1' \
        && ok "APT repository preconfigured with the pin (only vaevictis-*)" || bad "APT repository configured WITHOUT the keyring package or the pin"
else
    echo "  (APT repository not preconfigured: vv-apps without --apt-repo)"
fi
hidsleft=""
for f in usr/libexec/systemd-sysctl-helper etc/systemd/system/sysctl-helper.service usr/local/bin/hids-gui \
         usr/local/bin/hids-notify etc/xdg/autostart/hids-notify.desktop usr/share/applications/hids-security.desktop; do
    exists "$f" && hidsleft="$hidsleft /$f"
done
[ -z "$hidsleft" ] && ok "HIDS removed (1.1)" || bad "HIDS files still in the image (run vv-branding):$hidsleft"

head_ "Packages"
for p in systemd-cryptsetup cryptsetup-initramfs console-setup ffmpegthumbnailer firefox-esr grub-efi-amd64-bin grub-pc-bin os-prober efibootmgr \
         nftables fail2ban apparmor keepassxc lynis vaevictis-aurora bubblewrap xdg-dbus-proxy xdg-user-dirs plymouth plymouth-label \
         fonts-ibm-plex wl-clipboard wireguard-tools openresolv; do
    pkg_ok "$p" && ok "$p" || bad "$p is not installed"
done

head_ "Nothing personal inside"
leak=0
for pat in 'etc/wireguard/.+\.(conf|orig)$' 'id_(ed25519|rsa|ecdsa)' '\.kdbx$' '\.ovpn$' 'baseline\.json$' '/\.bash_history' '/\.ssh/' \
           'etc/ssh/ssh_host_.*_key$' '/\.mozilla|/\.config/mozilla|/\.config/BraveSoftware' 'passwords?.*\.csv$'; do
    hits="$(awk '{ print $NF }' "$W/list" | grep -E "$pat" | head -5 || true)"
    if [ -n "$hits" ]; then bad "found files matching $pat:"; printf '          %s\n' $hits; leak=1; fi
done
[ "$leak" = 0 ] && ok "no keys, VPN configs, histories, password files or browser profiles"
case "$(cat_of etc/shadow | awk -F: '$1=="root"{print $2}')" in
    '*'|'!'|'!*'|'!!') ok "root: locked, no password hash" ;;
    *) bad "root has a password hash inside the image (run: vv-chroot seal)" ;;
esac
exists etc/ssl/private/ssl-cert-snakeoil.key && bad "the TLS snakeoil private key is inside (run: vv-chroot seal)" || ok "no shared TLS private key"
rootleft="$(awk '{ print $NF }' "$W/list" | sed -n 's|^squashfs-root/root/\([^/]*\)$|\1|p' | grep -vxE '\.bashrc|\.profile' | tr '\n' ' ' || true)"
[ -z "$rootleft" ] && ok "/root holds only .bashrc and .profile" || bad "/root holds leftovers: $rootleft"
mid="$(size_of etc/machine-id)"
[ "${mid:-1}" = 0 ] && ok "machine-id is empty (new one at every boot)" || bad "machine-id is not empty (${mid:-missing})"
echo "  home/ in the image:"
awk '{ print $NF }' "$W/list" | sed -n 's|^squashfs-root/home/\([^/]*\)$|    \1|p' | sort -u | sed 's/^$/    (empty)/'
[ "$(awk '{ print $NF }' "$W/list" | grep -cE '^squashfs-root/home/[^/]+$')" = 0 ] && echo "    (no user home)"

head_ "Result"
SUM="$(sha256sum "$ISO" | cut -d' ' -f1)"
echo "  SHA-256  $SUM"
echo "  size     $(du -h "$ISO" | cut -f1)"
if [ "$FAILS" = 0 ]; then echo "  ALL CHECKS PASSED"; else echo "  $FAILS CHECK(S) FAILED: do not publish this image"; exit 1; fi
